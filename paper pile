<script id="catalog" type="application/json">[{"id": "Agriculture", "name": "Agriculture", "problems": [{"id": "agriculture-local-1", "title": "How can farmers compare what they’ll actually take home from selling at different markets?", "description": "A higher price at a market farther away can look attractive until the farmer pays for transport, loading, and other charges. The price may also be for a different grade or quantity.", "why": "A useful comparison needs to show what the farmer expects to receive after costs, and when each buyer expects to pay. That makes it easier to see which trip is worth making.", "severity": 4, "rank": 2}, {"id": "agriculture-local-2", "title": "How can farmers find a shared farm machine that is free during their short harvest window?", "description": "A machine owner may be nearby and still be booked through the days a crop is ready. Finding out by phone can take time, especially when the harvest date shifts.", "why": "Farmers need to know when the machine can actually arrive, what jobs it can handle, and whether the quoted price includes an operator and travel.", "severity": 4, "rank": 1}, {"id": "agriculture-local-3", "title": "How can growers keep track of produce sent to a buyer and check that the final payment matches?", "description": "A grower may send several loads to the same buyer, with each load weighed and graded separately. The buyer may then pay for several deliveries together.", "why": "When weights, deductions, and payments are written in separate places, it becomes hard to tell whether a load was left out. Growers need a record they can check against what reached their account.", "severity": 4, "rank": 3}, {"id": "agriculture-local-4", "title": "How can small growers check whether borrowed cold-storage space will be available when their crop is ready?", "description": "A grower can know where the nearest cold room is and still have no idea whether it has room on harvest day. The facility may also have storage conditions that suit one crop better than another.", "why": "Before arranging a trip, growers need to confirm what the facility accepts, how much space is free, and what the full stay will cost. Otherwise, freshly harvested produce can sit waiting while they look elsewhere.", "severity": 4, "rank": 4}, {"id": "agriculture-local-5", "title": "How can growers keep a buyer’s quality requirements straight when preparing several produce orders?", "description": "Two buyers can ask for the same crop but expect different sizes, packaging, or delivery times. Those details often arrive in calls or messages while the grower is also arranging harvest and packing.", "why": "If a change is missed, an otherwise usable load can be rejected or paid at a lower rate. Keeping the latest requirements with each order makes it easier to check what should be packed and where it should go.", "severity": 4, "rank": 6}, {"id": "agriculture-local-6", "title": "How can farmers share an irrigation pump without losing track of whose turn it is?", "description": "Several farmers can depend on the same pump. Rain, outages, or a longer-than-expected watering turn can throw off the plan, and the next person might not hear about the change.", "why": "A clear schedule needs to show both the planned turn and whether the pump is actually free. This helps farmers adjust work around the slot and keep a record of how the equipment was shared.", "severity": 4, "rank": 5}, {"id": "agriculture-local-7", "title": "How can farm workers and growers check the days worked and payments still due?", "description": "A grower may hire people for different jobs across several days, with some paid daily and others paid after the work is finished. Notes taken in the field can be hard to reconcile later.", "why": "Workers and growers need a shared record of the dates, agreed pay, and payments already made. That gives both sides something to check if their totals differ.", "severity": 4, "rank": 3}]}, {"id": "B2B Services", "name": "B2B Services", "problems": [{"id": "daily-b2b-1", "title": "How can small suppliers tell whether they can cover wages and materials while waiting for a large buyer to pay?", "description": "Small suppliers often have to pay wages and buy materials before their customers pay for finished orders. If a buyer is slow to approve an invoice or asks a question about a delivery, the money may arrive after those bills are due.", "why": "The owner needs to know what will actually be in the bank on payday. That means checking cash on hand, the bills coming up, and which customers are likely to pay in time. Those dates can live in different places, like a spreadsheet, a bill, and an email from the buyer. If one date changes and the other records stay the same, the owner may only spot the gap when it’s too late to plan around it.", "severity": 4, "rank": 1}, {"id": "daily-b2b-2", "title": "How can an exporter with a signed order but little collateral pay suppliers before production starts?", "description": "A signed purchase order confirms future demand, but it does not put cash in the exporter’s account. Suppliers may require a deposit before production, while lenders may ask for assets the exporter cannot pledge.", "why": "The exporter has to pay for materials or production before a finished shipment can generate an invoice. Even if the order is profitable, the business may lack the cash needed to fulfill it. Taking on another order can widen that gap instead of easing it. The financing decision depends on more than the order value. The business needs to know what it must pay at each stage, whether the buyer can change or cancel the order, and how long it may take to collect after shipment. Those details determine whether funding can last through the full production and payment cycle.", "severity": 4, "rank": 11}, {"id": "daily-b2b-3", "title": "How can a small manufacturer find procurement teams that already buy the kinds of components it makes?", "description": "Small manufacturers know what their machines can produce, but buyer directories rarely reveal which procurement teams are sourcing those components. Sales teams spend time approaching firms whose tolerances, volumes, or materials do not match their capabilities.", "why": "A buyer in the right industry is not necessarily a fit. Its team might need a different material, precision level, or order volume. A broad contact list leaves the manufacturer to uncover those differences one conversation at a time. The key missing information is what a buyer is sourcing now or expects to source soon, and who handles that purchase. Without that context, a capable manufacturer can overlook a good match or spend weeks on leads that never turn into requests for quotes.", "severity": 3, "rank": 12}, {"id": "daily-b2b-4", "title": "How can a factory fill an extra production shift with workers who can operate its machines safely?", "description": "An extra shift is useful only if enough operators are qualified for the machines on that line. Availability, training records, and shift schedules may sit in separate places, making it hard to confirm safe staffing in time.", "why": "Being available for a shift is different from being trained for a specific machine or task. A supervisor may find enough people on paper and still lack the combination of operators the production line needs. The staffing decision requires a reliable view of qualifications, availability, and the work scheduled on that line. If those records are checked separately, the gap may only become clear at shift handover, when the supervisor has less time to move work or find qualified coverage. A supervisor trying to cover a late shift may have to check several rosters before finding someone trained on the right line. Staffing the shift also depends on which tasks must run together, because a gap at one station can hold up the rest.", "severity": 4, "rank": 11}, {"id": "daily-b2b-6", "title": "How can manufacturers tell which customer orders will miss their delivery dates when a truck fails to arrive?", "description": "A missed truck pickup can affect several orders with different deadlines. Without linking the truck’s load to those orders, dispatchers cannot quickly tell which customers need a revised delivery date or which goods should be moved first.", "why": "One truck may carry products for several customers, and those orders may not all have the same delivery deadline. If the truck fails to show, knowing the total load is delayed does not reveal which commitments will actually be missed. Dispatch needs to connect the assigned cargo to customer orders and compare the remaining time with realistic alternatives. That tells the team which orders can wait, which need another vehicle, and which customers need an updated delivery estimate.", "severity": 4, "rank": 8}, {"id": "daily-b2b-7", "title": "How can a small business compare what two suppliers will actually charge once freight, taxes, and payment terms are included?", "description": "Two suppliers can quote similar unit prices while charging very different amounts for freight, taxes, and minimum quantities. Comparing the quotes also means considering when cash leaves the business under each payment schedule.", "why": "A lower unit price can become the more expensive deal once shipment size, delivery charges, or taxes are accounted for. Quotes may also use different assumptions about what is included or when an order qualifies for a discount. The buyer needs to compare the same quantity delivered to the same location. It also matters when deposits or final payments come due. The full cost and the timing of those payments tell different parts of the story, especially for a business with limited cash on hand.", "severity": 3, "rank": 12}, {"id": "daily-b2b-8", "title": "How can a business track a GST filing issue that needs a tax officer’s intervention before the deadline passes?", "description": "A filing issue that requires an officer can sit outside the business’s normal filing workflow. The business needs to know who has the case, whether more documents are needed, and how close it is to missing the deadline.", "why": "Some filing issues cannot be completed by the business alone because the next step sits with an officer. An acknowledgement may confirm that the issue was reported without showing when it will move or whether the business needs to provide anything else. The business needs to connect the filing deadline with its case reference, prior communications, and outstanding documents. Without a clear timeline, staff can spend time repeatedly checking the case while remaining unsure what they can do to avoid a missed filing.", "severity": 4, "rank": 15}, {"id": "daily-b2b-11", "title": "How can a factory identify a machine fault remotely so the technician arrives with the right spare parts?", "description": "A technician called to a stopped machine may receive only a brief description of the fault. Without the machine model, error history, and operating conditions, the technician may arrive without the right tools or parts, extending downtime.", "why": "A stopped machine is often reported as a symptom, such as an error message or a failed restart. The same symptom can have several causes, and the person reporting it may not know which earlier changes or readings matter. Before leaving, the technician needs enough context to narrow down likely faults and prepare for the visit. A clear record of the model, conditions when the fault appeared, and recent maintenance makes the first trip more useful and reduces avoidable trips for parts.", "severity": 4, "rank": 11}, {"id": "daily-b2b-16", "title": "How can a small accounts team tell which invoices a single bank transfer covers when the customer sends no payment breakdown?", "description": "A bank transfer can settle several invoices at once. Without a remittance breakdown, an accounts team has to compare amounts and references manually, and a wrong match can leave the ledger showing bills that were already paid.", "why": "The amount in the bank account may cover several invoices, part of an invoice, or a lower total after deductions. More than one combination can match the same transfer amount, so a correct-looking total does not prove the match. The accounts team needs evidence that connects the payment to specific invoices, such as a buyer reference or payment advice. Until it has that detail, normal follow-ups can go wrong: the business might chase an invoice that was paid while overlooking one that is still due.", "severity": 3, "rank": 7}, {"id": "daily-b2b-20", "title": "How can a manufacturer give a buyer a quote that stays workable if material prices change before the order is confirmed?", "description": "A quote can remain open while the cost of a key material changes. Suppliers need to distinguish costs already locked in from those that may rise before the buyer confirms, so they can see whether the quoted margin still holds.", "why": "A buyer may take time to confirm a quote after the manufacturer has priced materials at today’s rates. If a material cost increases before the order is accepted, the supplier can face a choice between honoring a thin margin and reopening negotiations. The key is knowing which inputs are already secured, which could change, and how much those changes would affect the order. A quote is easier to stand behind when its assumptions and validity period are clear before the buyer commits.", "severity": 3, "rank": 14}, {"id": "daily-b2b-5", "title": "How can sports-equipment makers find a lab that runs every test their buyer requires before the shipment deadline?", "description": "A sports-equipment buyer may require several tests with different lab capabilities and turnaround times. Manufacturers need to confirm coverage and available dates before sending samples.", "why": "A lab that performs one required check may refer the remaining checks elsewhere. The manufacturer has to account for both schedules and the time needed for reports before promising a shipping date.", "severity": 4, "rank": 13}, {"id": "daily-b2b-9", "title": "How can a supplier turn electricity bills and fuel records into the emissions data a major buyer asks for?", "description": "Electricity and fuel records may use different periods and units than a buyer’s reporting request.", "why": "Suppliers need to collect consistent records and document how each figure was calculated.", "severity": 4, "rank": 4}, {"id": "daily-b2b-10", "title": "How can a manufacturer work out how many orders it needs to break even after a marketplace’s fees and returns?", "description": "Revenue can exceed production cost while fees, shipping, and returns erase the margin. A manufacturer needs to estimate contribution per order before setting a sales target.", "why": "Selling more units does not automatically improve profit if every additional parcel brings fees, shipping costs, and returns. The manufacturer needs to see what remains from each sale before relying on a volume forecast.", "severity": 4, "rank": 3}, {"id": "daily-b2b-12", "title": "How can a business take over an unfinished freelance project when the files and accounts are controlled by the contractor?", "description": "When a freelancer leaves, working files and account access may stay with them.", "why": "A business needs the current source materials and authorized access to continue the project.", "severity": 4, "rank": 6}, {"id": "daily-b2b-13", "title": "How can a business check whether a successful prototype can be reproduced consistently across a small production run?", "description": "A prototype can work even when small production runs vary. Recording tolerances, materials, and test results helps a producer establish which variation matters.", "why": "A successful prototype shows that one unit can meet the requirement. A supplier also needs to know whether the same material and process can produce several units consistently enough to pass the agreed checks.", "severity": 4, "rank": 5}, {"id": "daily-b2b-14", "title": "How can several neighbourhood restaurants share a bulk ingredient order when they need different quantities on different days?", "description": "A shared order can reach a wholesaler’s minimum while each restaurant only needs part of it. The challenge is coordinating order timing, allocation, and payment.", "why": "The restaurants may reach the minimum order collectively while needing ingredients on different days. They have to agree how to divide deliveries and who pays if one participant changes their order.", "severity": 3, "rank": 9}, {"id": "daily-b2b-15", "title": "How can a retailer tell whether buying directly from a brand will tie up too much cash in slow-selling stock?", "description": "Buying direct may reduce unit cost but require a larger order.", "why": "Retailers need to weigh savings against how long inventory will sit and how much cash it absorbs.", "severity": 4, "rank": 5}, {"id": "daily-b2b-17", "title": "How can a retailer avoid promising a delivery date before its supplier has reserved the stock?", "description": "A supplier can show stock as available before it is reserved for a particular order. Retailers need confirmation before making a delivery promise to customers.", "why": "A product marked in stock can be sold to another buyer before the retailer’s order is accepted. The seller needs to distinguish a live quantity from units that are genuinely held for a customer.", "severity": 4, "rank": 2}, {"id": "daily-b2b-18", "title": "How can a small supplier check whether its certificates and past contracts meet a tender’s requirements before preparing a bid?", "description": "Tender eligibility may depend on exact dates, certificates, and project sizes. Checking evidence against each requirement early helps suppliers avoid preparing bids they cannot submit.", "why": "A business can have the right experience and still lack a current document in the exact form the buyer requests. Checking those details early helps it decide whether a particular tender is feasible.", "severity": 3, "rank": 10}, {"id": "daily-b2b-19", "title": "How can a factory estimate whether an equipment upgrade will cut its electricity bill enough to pay for itself?", "description": "Quoted energy savings may assume a different operating schedule from the factory’s.", "why": "Owners need expected savings under their own usage and tariffs to compare against upfront costs.", "severity": 4, "rank": 8}]}, {"id": "Beauty & Personal Care", "name": "Beauty & Personal Care", "problems": [{"id": "beauty-2", "title": "How can shoppers tell whether branded cosmetics are genuine before buying them?", "description": "Counterfeit cosmetics may copy the packaging and listing photos of genuine stock. Shoppers need a way to connect the item and batch in hand to a trustworthy supply channel.", "why": "Shoppers can judge a listing by photos and reviews, but those signals may tell them little about the specific item they receive. A familiar logo or sealed box is easy to recognize and may still be insufficient to establish where the product came from. Useful checks connect the seller, the package, and the product’s identifying details. When that information is missing or hard to verify, shoppers have to decide whether to trust the item using clues that may be easy for a counterfeit seller to imitate.", "severity": 4, "rank": 1}, {"id": "beauty-3", "title": "How can shoppers check whether a batch of cosmetics has been flagged for failing quality standards?", "description": "A quality alert usually identifies specific batches rather than every product sold under a brand. Shoppers need to read a batch number on the package and match it to the relevant notice before using the item.", "why": "Two packages of the same product can come from different manufacturing batches. A notice about one batch may therefore apply to one package while a nearly identical package is outside the notice. The shopper needs the exact batch identifier and a trustworthy notice that lists the affected batch. The search becomes harder when the code is faint, the alert uses a different product name, or the shopper cannot tell whether an old notice applies to their package.", "severity": 4, "rank": 11}, {"id": "beauty-4", "title": "How can customers check a hair dye’s ingredients, safety warnings, and patch-test instructions before using it?", "description": "The information needed before using a hair dye may be split across packaging, inserts, and seller listings.", "why": "Missing or unreadable directions make it harder to check ingredients and follow the manufacturer’s safety instructions.", "severity": 4, "rank": 11}, {"id": "beauty-5", "title": "How can shoppers tell which skincare and personal care claims are backed by evidence?", "description": "Skincare labels often use broad phrases such as clinically tested without saying what was tested.", "why": "Shoppers need to see whether the evidence addresses the advertised result, the ingredient, and the concentration in that product.", "severity": 3, "rank": 4}, {"id": "beauty-6", "title": "How can salons assess a beauty worker’s practical skills before hiring them?", "description": "A candidate’s résumé or portfolio may show finished work without showing how they performed it.", "why": "Salons need a consistent way to assess technique, hygiene, and handling of client requests before assigning appointments.", "severity": 3, "rank": 12}, {"id": "beauty-7", "title": "How can people find a qualified dermatologist when few are available nearby?", "description": "A directory listing can show a dermatologist’s name without showing whether they are taking appointments.", "why": "People in areas with few specialists may spend time contacting clinics or travelling before discovering they cannot be seen.", "severity": 4, "rank": 3}, {"id": "beauty-8", "title": "How can shoppers choose the right foundation shade online when swatches look different across screens and lighting?", "description": "Foundation swatches change with camera settings, lighting, and screen color.", "why": "A shopper also needs to compare undertones, since products with similar lightness can look quite different on the skin.", "severity": 2, "rank": 10}, {"id": "beauty-10", "title": "How can customers see the full cost of a salon service, including hair-length charges and add-ons, before booking?", "description": "An advertised salon price may cover only the basic service.", "why": "Hair length, product use, or add-ons can change the final charge, leaving clients unable to compare offers before booking.", "severity": 3, "rank": 11}, {"id": "beauty-11", "title": "How can customers check whether a salon disinfects reusable tools between appointments?", "description": "A client can see that a tool looks clean without knowing how it was cleaned between appointments.", "why": "Clear, consistent reporting of hygiene practices would make it easier to compare salons before visiting.", "severity": 4, "rank": 9}, {"id": "beauty-12", "title": "How can small salons reduce last-minute cancellations and fill open slots?", "description": "A cancellation close to the appointment can leave a worker idle even when other clients want that slot.", "why": "The salon needs an accurate schedule and a quick way to match the opening with clients who can arrive in time.", "severity": 3, "rank": 10}, {"id": "beauty-1", "title": "How can customers check whether an injectable beauty treatment offered by a salon or clinic is legally permitted?", "description": "Customers may struggle to distinguish a cosmetic service from a procedure requiring medical oversight.", "why": "They need accurate information about the provider’s qualifications and the treatment being offered.", "severity": 4, "rank": 2}, {"id": "beauty-9", "title": "How can people with fragrance sensitivities find suitable beauty products without buying full-size products to try them?", "description": "Fragrance information can be hard to interpret, and there may be no affordable sample.", "why": "Customers need clear product information and a way to try products without committing to a full size.", "severity": 3, "rank": 8}, {"id": "beauty-13", "title": "How can independent beauty professionals build a steady base of repeat customers beyond referrals?", "description": "Independent professionals can depend heavily on new referrals even when clients would book again. They need to manage follow-ups and availability without relying on one platform.", "why": "A returning client may want the same service but have trouble finding the professional’s latest hours or contact details. Keeping booking and follow-up information together can make repeat business easier to manage.", "severity": 3, "rank": 6}, {"id": "beauty-22", "title": "How can older adults and people with limited mobility book affordable at-home grooming services?", "description": "Getting to a salon can be difficult for people with limited mobility. At-home services need to give clear prices, coverage, and information about assistance needs.", "why": "A provider may say they offer home visits without describing what equipment they bring or what access they need. That information helps a customer decide if the service will work in their home.", "severity": 3, "rank": 5}, {"id": "beauty-23", "title": "How can salon customers reduce hair damage from colouring or bleaching?", "description": "Hair condition and previous treatments can affect how it responds to coloring or bleach.", "why": "Customers need a clear consultation about what they have had done and what the salon plans to use.", "severity": 3, "rank": 7}]}, {"id": "Consumer Services", "name": "Consumer Services", "problems": [{"id": "final-3.01", "title": "Why do customers need government escalation channels to recover fees from non-travel service agencies?", "description": "When an agency keeps a fee after a service dispute, its own support team may be unable to resolve the disagreement.", "why": "Customers need a clear record of what was promised, what was delivered, and where to raise an unresolved complaint.", "severity": 3, "rank": 7}, {"id": "final-3.02", "title": "Why do service-booking apps use guilt-based wording to pressure customers into optional paid protection?", "description": "A protection add-on can appear optional while the decline button suggests the customer is being careless.", "why": "This framing makes it harder to judge the value of the add-on on its own terms.", "severity": 2, "rank": 8}, {"id": "final-3.03", "title": "How can customers prevent unwanted subscription renewals and find a clear cancellation process for services?", "description": "Customers can sign up in a few taps but struggle to find the cancellation setting later.", "why": "A missed renewal notice or unclear cancellation deadline can lead to charges for a service they no longer use.", "severity": 3, "rank": 1}, {"id": "final-3.04", "title": "How can households verify that the LPG cylinder delivered to them contains the correct quantity of gas?", "description": "A sealed cylinder looks the same whether or not it contains the expected quantity of gas.", "why": "A customer needs a practical way to compare its measured weight with the empty-cylinder weight and the stated fill quantity.", "severity": 3, "rank": 3}, {"id": "final-3.05", "title": "How can consumers understand fine-print eligibility and exclusions in non-travel service promotions before paying?", "description": "Promotions can advertise savings prominently while hiding eligibility rules in separate terms. Customers need to know whether their booking qualifies before they commit.", "why": "A discount might apply only to certain services, customers, or booking times. If the buyer learns those limits after paying, it is too late to compare the actual cost with other offers.", "severity": 2, "rank": 6}, {"id": "final-3.06", "title": "How can customers challenge a manufacturer’s refusal to honor an appliance warranty or issue a refund?", "description": "A warranty dispute often turns on the purchase date, the fault, and the reason given for refusing repair.", "why": "If those records are scattered across receipts and support messages, the customer may struggle to show their case clearly.", "severity": 3, "rank": 5}, {"id": "final-3.07", "title": "How can ordinary consumers prepare evidence and file complaints against businesses without needing legal expertise?", "description": "Filing a consumer complaint is harder when evidence is spread across invoices, chats, and screenshots.", "why": "Customers need to organize a timeline and identify the remedy they are asking for without knowing formal complaint language.", "severity": 3, "rank": 2}, {"id": "final-3.08", "title": "How do parents find trustworthy evening childcare for short hours?", "description": "Parents who need care for a short evening shift may find providers offering only full-day or long-term arrangements.", "why": "A trustworthy match must cover the exact hours, location, supervision needs, and availability.", "severity": 4, "rank": 4}]}, {"id": "E-commerce", "name": "E-commerce", "problems": [{"id": "final-4.02", "title": "How can shoppers recover payment when online orders are marked delivered but never reach the buyer?", "description": "A delivery scan may close an order even though the buyer never received it.", "why": "The buyer needs a clear way to dispute the scan and connect their claim to handoff records or delivery proof.", "severity": 4, "rank": 3}, {"id": "final-4.03", "title": "Why do e-commerce platforms deny returns or exchanges despite published eligibility rules?", "description": "A product can look eligible under the published return policy until support rejects it.", "why": "Customers need to understand which policy applied at checkout and what reason the platform used to deny the return.", "severity": 3, "rank": 5}, {"id": "final-4.04", "title": "How can customers prevent repeated cancellation of scheduled defective-product return pickups?", "description": "A return can be approved while the courier pickup is repeatedly missed or cancelled.", "why": "Customers need visibility into who controls rescheduling and how missed pickups affect the return deadline.", "severity": 3, "rank": 6}, {"id": "final-4.05", "title": "How can online buyers request refunds or alternatives when committed delivery dates keep slipping after purchase?", "description": "Moving an estimated delivery date can leave customers waiting past when the item is useful.", "why": "They need a clear point at which they can choose to cancel, receive a refund, or accept an alternative.", "severity": 3, "rank": 5}, {"id": "final-4.06", "title": "How can buyers document damage to an e-commerce product at unboxing so sellers cannot dismiss valid complaints?", "description": "Damage discovered immediately after opening a package is difficult to distinguish from damage that happened later.", "why": "Buyers need a simple evidence record tied to the order and delivery time.", "severity": 3, "rank": 9}, {"id": "final-4.07", "title": "How can customers track refunds that remain pending after an accepted e-commerce return?", "description": "The shop can accept a return days before the money reaches the customer’s account.", "why": "Customers need to see who has the refund now. Is the seller still approving it, has the shopping site sent it, or is the payment provider still processing it?", "severity": 4, "rank": 4}, {"id": "final-4.08", "title": "Why do shoppers receive counterfeit products?", "description": "Listings can use genuine photos while the item delivered comes from an unverified seller.", "why": "Buyers may have difficulty authenticating the item or proving it differs from what was advertised.", "severity": 4, "rank": 2}, {"id": "final-4.09", "title": "Why are unexpected handling fees added specifically to cash-on-delivery orders?", "description": "A cash-on-delivery fee can appear only after customers choose the payment method.", "why": "Without seeing the full totals earlier, shoppers cannot compare methods fairly or budget for the last charge.", "severity": 2, "rank": 15}, {"id": "final-4.10", "title": "How can shoppers detect tax-inclusive price claims that change into extra mandatory checkout charges?", "description": "An advertised price may include tax but omit other compulsory charges.", "why": "When those charges appear late, shoppers cannot compare the real prices of competing products or sellers.", "severity": 3, "rank": 7}, {"id": "final-4.11", "title": "Why are fake and disguised reviews so common on shopping platforms?", "description": "Reviews can be incentivized, copied, or attached to a different version of the product.", "why": "Buyers trying to judge quality need signals that connect feedback to genuine use of the item being sold.", "severity": 3, "rank": 1}, {"id": "final-4.12", "title": "How can online buyers assess a seller’s delivery reliability before placing a high-value order?", "description": "A seller’s star rating may say more about the product than the reliability of delivery.", "why": "People placing an expensive order need evidence on dispatch, handoff, and how the seller resolves delivery failures.", "severity": 3, "rank": 7}, {"id": "final-4.13", "title": "How can customers verify that an electronic product is compatible with their existing devices before purchasing it?", "description": "Products with similar names can support different ports, standards, or software versions. Compatibility depends on the exact existing device and product variant, details listings may omit.", "why": "A plug may look like it fits while the device still lacks the required software support. Shoppers need the exact supported models and versions before they can tell whether an accessory will work.", "severity": 3, "rank": 8}, {"id": "final-4.14", "title": "How can online grocery customers verify missing or substituted items without filming each order?", "description": "Online grocery receipts may show what was charged without making substitutions and missing items obvious.", "why": "Customers need an easy way to compare orders with what arrived and flag discrepancies.", "severity": 3, "rank": 12}, {"id": "final-4.15", "title": "How can buyers confirm that the delivered large appliance has the exact model and specifications they ordered?", "description": "Large appliances can look identical across variants with different capacity or features.", "why": "Buyers need to compare the model identifier on the delivered unit with the one confirmed in the order.", "severity": 3, "rank": 14}, {"id": "final-4.16", "title": "How can shoppers detect and reject preselected paid extras, insurance, or donations at e-commerce checkout?", "description": "A preselected add-on can silently increase the price at checkout.", "why": "Shoppers need a clear way to see which charges are optional and confirm what they actually agreed to pay.", "severity": 2, "rank": 10}, {"id": "final-4.17", "title": "How can shoppers distinguish genuine limited-stock offers from misleading urgency tactics?", "description": "A countdown or low-stock label can pressure a buyer even when the offer continues.", "why": "Consumers need reliable context to distinguish a genuine availability constraint from a sales tactic.", "severity": 2, "rank": 11}, {"id": "final-4.23", "title": "Why do online marketplaces accept rural delivery pin codes without ensuring doorstep fulfillment is available?", "description": "A pin-code check may indicate that a parcel can reach the area even if the carrier cannot deliver to the address.", "why": "The customer may discover after purchase that collection from a distant point is required.", "severity": 3, "rank": 13}]}, {"id": "EdTech", "name": "EdTech", "problems": [{"id": "final-5.01", "title": "Why do coaching institutes refuse enrolment fee refunds even when students followed the terms?", "description": "Students may meet a refund condition but be asked for proof that is difficult to retrieve later.", "why": "The process depends on having a clear copy of the terms and a record of requests and deadlines.", "severity": 3, "rank": 18}, {"id": "final-5.02", "title": "How can prospective students verify coaching institutes’ selection-rate and placement-guarantee claims?", "description": "Selection and placement claims can use different groups of students as their denominator.", "why": "Prospective students need to see which intake was counted, how outcomes were checked, and what any guarantee actually covers.", "severity": 4, "rank": 8}, {"id": "final-5.03", "title": "Why are people pushed into paid workshops with false urgency and then denied a seat and a refund?", "description": "A rushed workshop sale can leave buyers paying before they know whether a seat is available.", "why": "Clear confirmation and refund terms matter when payment and enrollment are handled separately.", "severity": 3, "rank": 19}, {"id": "final-5.04", "title": "Why do students lose hostel fees when the coaching service itself was deficient?", "description": "Tuition and lodging may be sold together with separate refund rules.", "why": "Students may struggle to resolve the lodging charge when they leave over a teaching or service dispute.", "severity": 3, "rank": 20}, {"id": "final-5.05", "title": "How can students detect when multiple coaching institutes claim credit for the same exam topper?", "description": "A single high-scoring student may have taken several programs.", "why": "Promotional claims need to distinguish full enrollment, short courses, and test participation so families can compare them fairly.", "severity": 3, "rank": 17}, {"id": "final-5.06", "title": "Why do institutes not clearly say whether a course is recognised by UGC or AICTE?", "description": "Institutes may use broad recognition language even though approval depends on the institution, course, and program details.", "why": "Students need to check the specific qualification they would receive before paying.", "severity": 4, "rank": 12}, {"id": "final-5.07", "title": "How can students verify coaching faculty credentials and advertised refund rules before enrollment?", "description": "Faculty profiles and refund promises can be scattered across counselor messages and advertisements.", "why": "Students need to verify who will teach their batch and get the actual refund terms before committing.", "severity": 3, "rank": 15}, {"id": "final-5.08", "title": "Why are students pushed to sign agreements upfront before they can judge the course?", "description": "Students may be asked to accept binding terms before they can judge teaching quality or workload.", "why": "Up-front access to the agreement and course structure helps them understand the commitment.", "severity": 3, "rank": 16}, {"id": "final-5.09", "title": "How can students in schools without reliable internet access benefit from high-quality digital education?", "description": "Lessons that depend on streaming or repeated logins become hard to use when school connectivity fails.", "why": "Schools need material that can be kept available locally while still letting teachers track and guide learning.", "severity": 5, "rank": 1}, {"id": "final-5.10", "title": "How can schools provide practical computer-based learning when they have limited devices and infrastructure?", "description": "A school with few devices may teach computing in theory while students seldom practice.", "why": "Timetables, shared equipment, and offline tools determine how much hands-on time each student gets.", "severity": 4, "rank": 4}, {"id": "final-5.11", "title": "How can primary schools identify reading and foundational mathematics gaps early and personalize interventions?", "description": "A class can progress through its syllabus while some pupils still struggle with basic reading or number skills.", "why": "Teachers need to see which skill is missing early enough to give targeted practice.", "severity": 5, "rank": 1}, {"id": "final-5.12", "title": "How can schools identify students at risk of dropping out and intervene before they discontinue their education?", "description": "Dropout risk may build gradually across absences, missed work, and family difficulties.", "why": "Those signals can be visible to different staff members without anyone seeing the pattern early enough to intervene.", "severity": 5, "rank": 2}, {"id": "final-5.13", "title": "How can students and families receive better guidance when transitioning from middle school to secondary school?", "description": "Moving to secondary school can bring new subject choices, fees, and travel arrangements.", "why": "Families need clear information before deadlines so they can choose a school and prepare for the transition.", "severity": 3, "rank": 14}, {"id": "final-5.14", "title": "How can students with physical disabilities independently identify and access schools with suitable infrastructure?", "description": "A school may advertise accessibility without explaining whether classrooms, toilets, and transport can be used independently.", "why": "Students need details about the full daily route through the school.", "severity": 4, "rank": 6}, {"id": "final-5.15", "title": "How can schools with limited libraries provide affordable, engaging reading materials to students?", "description": "Schools with small libraries may lack books matched to readers’ interests and reading levels.", "why": "Affordable access also depends on having ways to circulate, replace, and replenish the books.", "severity": 4, "rank": 11}, {"id": "final-5.16", "title": "How can teenagers gain practical vocational skills while continuing their regular school education?", "description": "Practical training can clash with school hours or require transport to another site. Students need ways to build hands-on skills without missing academic classes.", "why": "Even when a program is available, the travel time or class timetable can make regular participation difficult. A workable option has to fit the school day as well as provide time to practice.", "severity": 4, "rank": 9}, {"id": "final-5.17", "title": "Why do fresh graduates lack practical coding skills despite strong academic performance?", "description": "Exams can reward recalling concepts while workplace coding requires debugging, collaboration, and delivering working software. Graduates need practice applying what they studied to open-ended tasks.", "why": "A graduate may understand a programming concept in isolation and still struggle to make changes in an unfamiliar project. Working through unclear requirements and responding to feedback takes a kind of practice that timed exams may miss.", "severity": 4, "rank": 5}, {"id": "final-5.18", "title": "Why are college choices influenced by referral fees instead of student aptitude?", "description": "Some advisers have financial ties to the colleges they recommend. Students need visibility into those incentives and comparable information about programs that fit their interests.", "why": "Families can mistake a counselor’s confidence for evidence that a course is a good fit. Knowing whether the advisor is paid for referrals helps them weigh the recommendation alongside fees, skills taught, and student outcomes.", "severity": 4, "rank": 13}, {"id": "final-5.20", "title": "Why don't global learning platforms support high-quality regional language instruction?", "description": "Translating a lesson does not automatically make it suitable for a regional audience.", "why": "Good instruction also requires accurate terminology, relevant examples, and readable materials in the learner’s language.", "severity": 4, "rank": 7}, {"id": "final-5.22", "title": "Why are mock tests and analytics inaccessible to low-income exam candidates?", "description": "Exam candidates may find practice questions for free but lack timed tests or feedback on weak areas.", "why": "The cost of regular practice and analysis can make preparation less accessible.", "severity": 4, "rank": 10}, {"id": "final-5.23", "title": "Why is scholarship information fragmented and inaccessible to low-income and rural students?", "description": "Scholarship details live on many portals and often use different eligibility rules and deadlines.", "why": "Students can miss support simply because they cannot tell which awards they qualify for in time.", "severity": 4, "rank": 3}]}, {"id": "FinTech", "name": "FinTech", "problems": [{"id": "final-6.01", "title": "Why do people pay insurance premiums for policies that are never issued?", "description": "A paid premium does not prove the insurer issued and activated the policy.", "why": "Customers need a clear way to track issuance and resolve a payment that remains tied to an incomplete application.", "severity": 4, "rank": 14}, {"id": "final-6.02", "title": "How can insurance policyholders spot exclusions and challenge incorrect premium charges or rejected policy refunds?", "description": "Exclusions and refund terms may be written differently from the sales summary.", "why": "Customers need the terms that applied to their policy alongside the billing or refund decision to understand what can be disputed.", "severity": 4, "rank": 12}, {"id": "final-6.03", "title": "Why do digital lending apps hide or misstate loan terms?", "description": "A borrower can see a headline rate without seeing the full cost, repayment schedule, or deductions.", "why": "Terms need to be legible before acceptance and match what appears in later statements.", "severity": 4, "rank": 1}, {"id": "final-6.04", "title": "How can banks identify account takeovers and suspicious transfers before a compromised account loses funds?", "description": "An account takeover may be noticed only after a transfer has gone through.", "why": "Banks need to recognize unusual account or payment activity fast enough to verify it while allowing ordinary transactions.", "severity": 5, "rank": 3}, {"id": "final-6.05", "title": "How can bank customers find one clear owner and escalation path for disputes involving loans or credit cards?", "description": "A loan or card dispute may move between teams without one person accountable for a resolution.", "why": "Customers need an owner, a case history, and a clear next step when a response is overdue.", "severity": 4, "rank": 11}, {"id": "final-6.06", "title": "Why must customers wait 30 days for a bank to respond before they can approach the RBI Ombudsman?", "description": "A bank complaint and a later escalation are separate stages.", "why": "People need to know when the bank received the complaint, whether it responded, and which documents to carry forward if it remains unresolved.", "severity": 3, "rank": 16}, {"id": "final-6.07", "title": "Why can't customers easily tell whether a lending app is legal?", "description": "A lending app can display a familiar logo without clearly identifying who actually lends the money.", "why": "Borrowers need a reliable way to establish the lender’s identity and compare it with official records before sharing data.", "severity": 5, "rank": 2}, {"id": "final-6.08", "title": "Why do new credit card users not understand charges, interest and repayment cycles?", "description": "New cardholders may confuse the statement balance, minimum payment, and due date.", "why": "That confusion can lead to charges they did not expect or balances that grow over time.", "severity": 4, "rank": 8}, {"id": "final-6.09", "title": "Why do pensioners struggle to get their pension problems solved by banks?", "description": "A missing or incorrect pension payment can involve both the bank and the authority that authorized payment.", "why": "Pensioners may be sent between them without a clear account of which party needs to correct the record.", "severity": 5, "rank": 7}, {"id": "final-6.10", "title": "Why do rural customers file far fewer banking complaints than people in metro cities?", "description": "Customers far from a branch may face language, connectivity, and travel barriers when trying to complain.", "why": "Low complaint counts can miss problems that customers were unable to report.", "severity": 4, "rank": 10}, {"id": "final-6.11", "title": "How can borrowers independently verify that lenders are charging the correct interest, penalties, and loan-servicing fees?", "description": "A loan statement can combine interest, penalties, and service fees in ways that make an unexpected increase hard to trace.", "why": "Borrowers need enough detail to compare each charge with their loan terms and payment history.", "severity": 4, "rank": 9}, {"id": "final-6.12", "title": "How can credit-card users automatically identify incorrect charges and resolve billing disputes?", "description": "An unfamiliar card statement entry may use a billing name different from the shop’s name.", "why": "Customers need to identify genuine purchases, recognize actual errors, and keep evidence and status updates together if they dispute a charge.", "severity": 4, "rank": 9}, {"id": "final-6.13", "title": "How can people identify and resolve unexpected restrictions, charges, or problems associated with their bank accounts?", "description": "An account restriction or unexpected fee may appear without a clear reason in the app.", "why": "Customers need to identify what triggered it and what evidence or action is required to resolve it.", "severity": 4, "rank": 5}, {"id": "final-6.14", "title": "How can ATM users efficiently recover money when their accounts are debited but cash is not dispensed?", "description": "A failed ATM withdrawal may leave a debit even though no cash came out.", "why": "The customer needs the ATM location, reference, and debit status to follow the case across the bank and ATM operator.", "severity": 3, "rank": 17}, {"id": "final-6.15", "title": "How can borrowers detect incorrect information in their credit reports and get it corrected without navigating complicated procedures?", "description": "An incorrect account or late-payment entry can affect access to credit.", "why": "Borrowers need to locate the disputed record, identify who supplied it, and track the correction through both organizations.", "severity": 4, "rank": 9}, {"id": "final-6.16", "title": "How can families discover and claim forgotten bank deposits and financial assets belonging to deceased relatives?", "description": "Family members may not know which institutions hold a relative’s assets. Finding accounts and claiming them are separate tasks, each requiring reliable records and clear documentation.", "why": "A family might know a relative used a bank without knowing which branch, account, or product to ask about. Finding a record is only the starting point because each institution still needs to establish who may claim it.", "severity": 4, "rank": 13}, {"id": "final-6.17", "title": "How can first-time insurance buyers compare coverage and exclusions in understandable language before purchase?", "description": "Policies can use different wording for similar benefits and exclusions. First-time buyers need comparisons that identify what would actually be covered in situations they care about.", "why": "Two plans with similar prices can differ in waiting periods and what they exclude. A buyer needs to see those differences before deciding whether the cheaper plan covers the circumstances they care about.", "severity": 4, "rank": 4}, {"id": "final-6.19", "title": "Why do migrant workers lose money on remittances?", "description": "Two transfer services can quote similar fees while using different exchange rates. Workers need to compare the amount their family will receive after all deductions.", "why": "A service advertising a lower transfer fee can still send less to the recipient if its exchange rate is worse. Comparing the final amount received makes the total cost easier to see.", "severity": 4, "rank": 6}, {"id": "final-6.23", "title": "How can international card users compare exchange-rate markups and foreign-transaction fees before paying?", "description": "International card costs can include both a conversion markup and a separate transaction fee.", "why": "Shoppers need to see how those charges affect the amount posted to their card before choosing how to pay.", "severity": 3, "rank": 15}]}, {"id": "Food & Beverage", "name": "Food & Beverage", "problems": [{"id": "final-7.01", "title": "Why can't customers check a restaurant's hygiene before ordering on delivery apps?", "description": "Food-delivery listings show menus and ratings, but those ratings do not necessarily reflect kitchen hygiene. Customers need current information that identifies the kitchen preparing the order.", "why": "A delivery app may show one restaurant name even when food is prepared at different locations. A hygiene record is useful only if it refers to the kitchen handling that order.", "severity": 4, "rank": 4}, {"id": "final-7.02", "title": "Why do food delivery orders arrive with wrong or reduced items?", "description": "Restaurant item counts and substitutions can get lost between order acceptance and packing. A clear packing record helps customers identify what was omitted.", "why": "A customer may see the original order in the app while the restaurant sent a substitute or packed one item fewer. Clear item-level records make that difference easier to explain when the customer reports it.", "severity": 3, "rank": 13}, {"id": "final-7.03", "title": "Why do quick-commerce dark stores stock expired products?", "description": "Fast pick-and-pack workflows can overlook expiry dates when older stock remains on shelves.", "why": "A product can be listed as available even if the specific item picked is no longer suitable to send.", "severity": 4, "rank": 11}, {"id": "final-7.04", "title": "How can restaurant diners identify dishes containing undisclosed ingredient substitutes sold as the original food?", "description": "The menu name can suggest one ingredient while the dish uses a lower-cost substitute.", "why": "Diners need ingredient information before ordering, particularly when the change affects dietary restrictions.", "severity": 4, "rank": 8}, {"id": "final-7.05", "title": "Why do customers not know how to report unhygienic food at a restaurant?", "description": "A diner may know the restaurant name but be unsure how to report a hygiene issue or what evidence matters.", "why": "If receipts and observations are lost, the report becomes harder to investigate.", "severity": 3, "rank": 14}, {"id": "final-7.06", "title": "How can packaged-food buyers check misleading ingredient claims such as “natural,” “rich in milk solids,” or “premium chocolate” against the actual label?", "description": "Front labels can highlight premium ingredients without revealing their share of the recipe. Buyers need to compare those claims with the ingredient list.", "why": "A prominent ingredient name on the front can create an impression the list on the back does not support. Comparing the claim with the ingredient breakdown helps buyers see what is actually in the product.", "severity": 3, "rank": 10}, {"id": "final-7.07", "title": "How can consumers identify unverified disease-treatment claims made on packaged beverages?", "description": "A packaged beverage may use language that sounds like a treatment promise without pointing to evidence.", "why": "Buyers need to distinguish a general wellness claim from a specific, substantiated health claim.", "severity": 4, "rank": 11}, {"id": "final-7.08", "title": "How can households verify the quality and purity of milk and dairy products before consuming them?", "description": "Packaging and appearance tell households little about dairy quality. Reliable batch and supplier information can help them distinguish verified products from unsubstantiated claims.", "why": "A package can look normal while giving little information about the conditions in which the dairy product was produced or stored. Traceable batch information helps people identify which quality records apply to the item they bought.", "severity": 4, "rank": 4}, {"id": "final-7.09", "title": "How can small food manufacturers detect contaminated or substandard products before distributing them to customers?", "description": "A small producer may lack testing capacity and discover a quality issue only after a batch ships.", "why": "Batch records and appropriate quality checks are needed before dispatch.", "severity": 4, "rank": 6}, {"id": "final-7.10", "title": "How can street-food vendors learn and maintain proper food-hygiene practices without expensive training programs?", "description": "Training time and cost can make formal instruction difficult for street vendors. Material should fit the equipment, water supply, and preparation conditions vendors actually work with.", "why": "Instructions designed for a fully equipped kitchen may be difficult to apply at a small stall. Training needs to explain the relevant practices in terms of the space, supplies, and time vendors actually have.", "severity": 4, "rank": 5}, {"id": "final-7.11", "title": "How can small food vendors understand and complete food-safety registration and compliance procedures without relying on costly intermediaries?", "description": "Small vendors can struggle to identify which registration applies to their operation and what records they must supply.", "why": "Several forms and renewals can become hard to manage without help.", "severity": 3, "rank": 14}, {"id": "final-7.12", "title": "How can small fruit sellers limit spoilage while storing unsold produce without affordable cold rooms?", "description": "Fruit sellers often buy stock before knowing daily demand.", "why": "Without affordable cool storage or good visibility into remaining shelf life, they must discount quickly or lose unsold produce to spoilage.", "severity": 4, "rank": 9}, {"id": "final-7.13", "title": "How can vegetable vendors predict demand and prevent unsold produce from spoiling?", "description": "Demand for fresh vegetables changes by day and neighborhood. Vendors must buy ahead and absorb losses when sales are lower than expected.", "why": "The buying decision comes before the vendor knows how much will sell. Ordering too little means missed sales, while ordering too much leaves stock whose quality and value can fall before the next selling day.", "severity": 3, "rank": 7}, {"id": "final-7.14", "title": "How can small fish vendors preserve safe freshness during short-distance handling and retail display without costly refrigeration?", "description": "Fish can spend time unrefrigerated during handling and display, even on a short route.", "why": "Vendors need to manage the temperature and time throughout that chain while keeping costs within small margins.", "severity": 5, "rank": 2}, {"id": "final-7.15", "title": "How can egg distributors reduce breakage and spoilage during transportation from farms to retail stores?", "description": "Egg distributors lose stock when trays shift, shells crack, or shipments sit too long before reaching stores.", "why": "They need to identify where damage occurs so changes to packing or handling can reduce avoidable losses.", "severity": 3, "rank": 15}, {"id": "final-7.16", "title": "How can low-income households identify affordable, nutritious meals that help them meet their dietary requirements?", "description": "Prices, cooking time, and local availability limit which meals a household can prepare. Nutrition information is more useful when it fits those constraints.", "why": "A meal plan can look nutritious on paper but be impractical when ingredients are expensive or cooking facilities are limited. The useful choice is one the household can realistically buy and prepare regularly.", "severity": 4, "rank": 1}, {"id": "final-7.19", "title": "How can buyers verify alcohol authenticity before purchase?", "description": "Counterfeit bottles can resemble legitimate stock. Buyers need a way to verify the seller and product provenance before purchase.", "why": "A listing or seal alone may not establish where the bottle came from. The buyer needs enough traceable information to tell who supplied it and whether that source can be checked.", "severity": 4, "rank": 12}, {"id": "final-7.22", "title": "How can buyers assess adulteration and freshness risks in pre-ground spice powders?", "description": "Ground spices hide visual cues present in whole ingredients. Shoppers need reliable sourcing and batch information to assess purity and freshness.", "why": "Once spices are ground, a buyer has fewer clues about what went into the pack. A usable sourcing record should identify the producer and link any quality checks to the batch actually sold.", "severity": 4, "rank": 6}, {"id": "final-7.23", "title": "How can consumers verify water purification in delivery cans?", "description": "A delivered water can provides little visible evidence of where it was filled or how it was treated.", "why": "Customers need recent quality records tied to the supplier and batch.", "severity": 4, "rank": 3}]}, {"id": "Home Services", "name": "Home Services", "problems": [{"id": "final-8.01", "title": "How can home-service gig workers access benefits despite fragmented registration and fluctuating earnings?", "description": "Workers may earn through several platforms and have no steady employer to administer benefits.", "why": "Changing income and separate registration systems make it hard to know what coverage they qualify for or how to keep it active.", "severity": 4, "rank": 2}, {"id": "final-8.02", "title": "How can cleaners, electricians, and other home-service platform workers contest sudden account deactivation?", "description": "Losing access to a platform can cut off new work immediately.", "why": "A worker needs to see the reason for the decision, the evidence it relies on, and how to appeal while preserving records of past jobs.", "severity": 4, "rank": 9}, {"id": "final-8.03", "title": "Why do a few customer ratings determine how often home-service workers appear in booking results?", "description": "A worker with few bookings can see their ranking move sharply after one review.", "why": "Lower visibility can then make it harder to get enough new bookings to build a more representative record.", "severity": 3, "rank": 10}, {"id": "final-8.04", "title": "How can home-service platform workers resolve withheld earnings or unfair penalties without expensive disputes?", "description": "When a platform withholds pay, workers need a record of the job, agreed rate, deductions, and the reason for the hold.", "why": "Resolving small disputes can take more time and money than workers can afford.", "severity": 4, "rank": 2}, {"id": "final-8.05", "title": "Why do home-service marketplaces restrict independent follow-up work with previous customers?", "description": "Marketplace rules can restrict a customer and worker from arranging a follow-up directly.", "why": "Those restrictions affect the cost of repeat work and the worker’s ability to build a client base.", "severity": 3, "rank": 6}, {"id": "final-8.06", "title": "How can households prevent emergency plumbers from raising callout quotes after arriving at the property?", "description": "During a leak, households have little time to compare providers.", "why": "If the initial quote leaves out callout fees, parts, or after-hours charges, the price can rise after the plumber arrives.", "severity": 3, "rank": 12}, {"id": "final-8.07", "title": "Why can't customers cancel or get refunds when an assigned technician doesn't respond?", "description": "An assigned technician can stop responding while the booking remains open. Customers need a clear deadline and a way to request reassignment or recover payment.", "why": "While a booking remains open, the customer may not know whether someone is still coming or whether it is safe to book another provider. A clear status and resolution deadline would help them decide what to do next.", "severity": 3, "rank": 11}, {"id": "final-8.08", "title": "How can homeowners verify a repair technician's skills and previous work before allowing them into their homes?", "description": "A listing can describe a technician as experienced without showing their skills for the specific repair.", "why": "A household needs evidence of relevant work and a way to confirm who will actually arrive.", "severity": 4, "rank": 9}, {"id": "final-8.09", "title": "How can households estimate a fair market price for planned plumbing, electrical, and carpentry tasks before booking?", "description": "Trade jobs can be priced by visit, hour, or scope, and materials may be included or charged separately.", "why": "Households need comparable quotes for the same work to judge whether an offer is reasonable.", "severity": 3, "rank": 12}, {"id": "final-8.10", "title": "How can homeowners verify whether appliance replacement parts were needed, genuine, and fairly priced?", "description": "Homeowners may have little visibility into why a part was replaced or where the replacement came from.", "why": "A repair record needs to connect the diagnosis, the part fitted, its price, and any warranty.", "severity": 3, "rank": 7}, {"id": "final-8.11", "title": "How can households maintain tamper-resistant appliance repair records, replaced-parts histories, and warranty proof?", "description": "Appliance receipts, service records, and parts warranties can end up scattered across paper and messages.", "why": "Missing records make repeat faults harder to diagnose and earlier work harder to verify.", "severity": 3, "rank": 10}, {"id": "final-8.12", "title": "How can households identify whether an electrical, plumbing or structural problem requires urgent professional attention?", "description": "Similar-looking household faults can differ in urgency.", "why": "People need to communicate what they can observe and get routed to an appropriate professional without having to diagnose the underlying fault themselves.", "severity": 4, "rank": 2}, {"id": "final-8.13", "title": "How can independent carpenters, masons and other skilled workers find consistent local work without paying large commissions to intermediaries?", "description": "Independent tradespeople often hear about nearby work through intermediaries or word of mouth.", "why": "Uncertain job flow makes it hard to plan a schedule, and commission can reduce the earnings from each job.", "severity": 3, "rank": 3}, {"id": "final-8.14", "title": "How can homeowners track whether construction and renovation contractors are using the agreed quantities and quality of materials?", "description": "Materials ordered, delivered, and installed are often recorded separately. Owners need records tied to the agreed specification to spot substitutions or quantity differences.", "why": "If the contractor replaces a specified material, the change may be hard to see once it is installed. Being able to match delivered quantities and product details to the agreed scope gives owners a basis for asking about discrepancies.", "severity": 4, "rank": 1}, {"id": "final-8.15", "title": "How can homeowners enforce the workmanship warranty when a previously repaired appliance fails again?", "description": "When a repaired appliance fails again, the customer needs to show what the original work covered and whether the same fault returned.", "why": "Without that record a provider may treat it as a new job.", "severity": 3, "rank": 5}, {"id": "final-8.16", "title": "How can homeowners compare renovation bids that use inconsistent labor, material, and quantity descriptions?", "description": "Renovation quotes may group tasks differently or leave materials and quantities unspecified.", "why": "Owners need to compare the same scope and see which costs could still change after work starts.", "severity": 3, "rank": 12}, {"id": "final-8.20", "title": "Why are pest control treatments ineffective within months?", "description": "Pests can recur if entry points or breeding conditions remain. Customers need to understand what the treatment covers and how the provider handles recurrence.", "why": "A treatment can remove visible pests while leaving the underlying source unchanged. If the pests return, the household needs to understand whether another visit is covered and what conditions still need attention.", "severity": 3, "rank": 4}, {"id": "final-8.21", "title": "How do customers find water tank cleaning services?", "description": "A tank cleaning listing may omit the equipment, method, and tank types a provider serves. Households need enough information to book someone suited to their installation.", "why": "An overhead tank and an underground tank can require different access arrangements. A customer needs to confirm what the provider can reach and what is included before scheduling the work.", "severity": 3, "rank": 13}, {"id": "final-8.22", "title": "How do customers book electricians for small jobs?", "description": "A small electrical job may not justify travel for a provider.", "why": "Customers need to find someone qualified who accepts short jobs and gives the minimum visit cost upfront.", "severity": 3, "rank": 8}]}, {"id": "Logistics", "name": "Logistics", "problems": [{"id": "final-9.01", "title": "How can courier companies identify and resolve delayed parcels before a promised delivery window expires?", "description": "Parcel tracking can reveal a missed scan without showing whether there is still time to recover the delivery.", "why": "Couriers need to identify the stalled handoff and prioritize shipments closest to their promised deadline.", "severity": 4, "rank": 5}, {"id": "final-9.02", "title": "How can couriers locate and resolve parcels that never reach their intended recipient?", "description": "A missing parcel can sit between a sorting facility, driver, and delivery partner.", "why": "Finding it depends on reconstructing the last confirmed handoff and assigning someone to investigate.", "severity": 4, "rank": 6}, {"id": "final-9.03", "title": "Why do courier agents refuse delivery to a valid door address within an advertised coverage area?", "description": "Coverage for an area does not always translate to an agent serving every address.", "why": "Dispatchers need to tell customers which handoff is possible before promising door delivery.", "severity": 3, "rank": 9}, {"id": "final-9.04", "title": "How can shippers establish courier accountability for parcels found damaged on arrival?", "description": "Damage may be discovered only after a package is opened.", "why": "Without records at pickup and at later handoffs, it is difficult to separate packing issues from damage during transport or delivery.", "severity": 4, "rank": 6}, {"id": "final-9.05", "title": "Why do hundreds of courier grievances stay pending?", "description": "A courier complaint can stall when several companies handle the same package and each has only part of the record.", "why": "The customer needs to know who is dealing with the complaint, what they’ve done so far, and when to expect an update.", "severity": 3, "rank": 6}, {"id": "final-9.06", "title": "How can small transporters access up-to-date lane-wise road freight-rate benchmarks?", "description": "A freight rate depends on the route, vehicle type, load, and current capacity.", "why": "Small operators with few recent quotes can struggle to judge whether a price reflects comparable trips.", "severity": 3, "rank": 10}, {"id": "final-9.07", "title": "Why is there a shortage of truck drivers that leaves trucks idle?", "description": "A truck can be ready while no appropriately qualified driver is available for the route or shift.", "why": "Operators need a better view of availability and scheduling constraints.", "severity": 4, "rank": 1}, {"id": "final-9.08", "title": "How can small transport operators reduce the number of trucks returning empty after completing deliveries?", "description": "A truck may finish a delivery where the operator has few customers.", "why": "Finding a return load depends on matching the truck’s availability, route, and capacity with a shipper’s pickup window.", "severity": 4, "rank": 5}, {"id": "final-9.09", "title": "How can businesses track shipments across multiple transport companies without manually calling different operators?", "description": "Transport companies can use different order references and status terms.", "why": "Businesses with many carriers need a common shipment record to see which deliveries are on schedule and which need attention.", "severity": 3, "rank": 7}, {"id": "final-9.10", "title": "How can small exporters predict unexpected logistics expenses before accepting international orders?", "description": "An export price can look profitable until handling, storage, or destination charges appear.", "why": "Small exporters need to understand which charges are included and which depend on what happens in transit.", "severity": 3, "rank": 11}, {"id": "final-9.11", "title": "How can farmers find affordable transportation for small quantities of agricultural produce without booking an entire truck?", "description": "Small harvests may not fill a truck, yet a dedicated trip can cost too much per crate.", "why": "Sharing transport requires compatible routes and pickup times, plus enough predictability to get produce to market while it is still saleable.", "severity": 4, "rank": 4}, {"id": "final-9.12", "title": "How can shippers log temperature excursions and prove cold-chain compliance during transport of sensitive goods?", "description": "A delivery can look fine when it arrives even if it got too warm or too cold on the way.", "why": "The shipper needs temperature readings that show when the change happened and who had the shipment at the time.", "severity": 4, "rank": 3}, {"id": "final-9.13", "title": "How can small warehouses prevent inventory discrepancies when goods are received, moved or dispatched?", "description": "Inventory counts drift when movements are recorded late or against the wrong location.", "why": "Small warehouses need each receipt, transfer, and dispatch reflected in the same stock record.", "severity": 4, "rank": 2}, {"id": "final-9.14", "title": "How can logistics companies identify repeated loading and unloading delays at warehouses and distribution centers?", "description": "Waiting to load or unload reduces the number of trips a vehicle can complete.", "why": "Consistent arrival, dock, and departure timestamps are needed to separate repeat bottlenecks from isolated delays.", "severity": 3, "rank": 10}, {"id": "final-9.15", "title": "How can businesses compare end-to-end road, rail, and multimodal freight costs and reliability?", "description": "A lower line-haul rate can be offset by transfers, terminal fees, or longer transit.", "why": "Shippers need to compare complete routes using the same shipment assumptions and service requirements.", "severity": 3, "rank": 11}, {"id": "final-9.20", "title": "How can logistics operators use impact sensors and chain-of-custody records to prevent mishandling of fragile freight?", "description": "Fragile goods may pass through several operators before damage is detected. Time-stamped handling records can help identify the stage that needs investigation.", "why": "When a box is opened only at its destination, its final condition gives little clue about which handoff caused the damage. A record that links impacts to the shipment and time can help narrow the investigation.", "severity": 4, "rank": 8}]}, {"id": "Payment Issues", "name": "Payment Issues", "problems": [{"id": "final-10.01", "title": "How can UPI users recognize fake QR codes, fraudulent collect requests, and cashback scams before authorizing payment?", "description": "A payment prompt can look legitimate while sending money to someone other than the intended recipient.", "why": "Users need to be able to verify who receives the money and what the approval screen will authorize before confirming.", "severity": 5, "rank": 1}, {"id": "final-10.02", "title": "Why are so many UPI fraud cases never reported officially?", "description": "Someone who discovers payment fraud may spend time trying to work out where to report it or which transaction details are needed.", "why": "A fragmented process can leave incidents unreported and make patterns harder to detect.", "severity": 4, "rank": 4}, {"id": "final-10.03", "title": "Why do money-mule accounts make stolen money so hard to recover?", "description": "Stolen funds may pass through several accounts before investigators can follow them. Disconnected records and delayed reporting complicate attempts to trace the money.", "why": "Each organization may see only part of the transaction history. Investigators need reliable references and timestamps to connect those partial records before they can establish where the funds went.", "severity": 5, "rank": 3}, {"id": "final-10.04", "title": "Why must victims act within the first hour to freeze stolen money?", "description": "After a fraudulent transfer, funds may move quickly through multiple accounts.", "why": "Prompt reporting gives the institutions involved a better chance to trace the transfer and investigate whether the money can still be recovered.", "severity": 5, "rank": 7}, {"id": "final-10.05", "title": "How can a payer quickly trace and reverse a digital payment debited from their account but not credited to the merchant?", "description": "A debit on one side and a missing credit on the other can leave both parties unsure what happened.", "why": "Resolving it requires a shared reference and a status that distinguishes a pending transfer from a failed one.", "severity": 4, "rank": 2}, {"id": "final-10.06", "title": "Why is there no chargeback for high-value digital payments when fraud occurs?", "description": "Users may assume all payment methods have the same dispute process.", "why": "After a fraudulent high-value transfer, they need clarity on the recovery options available for that payment type.", "severity": 5, "rank": 5}, {"id": "final-10.07", "title": "How can merchants understand when UPI acceptance fees or payment-processing charges apply to a transaction?", "description": "Merchants can face different fees depending on the provider and payment arrangement. A clear charge breakdown helps them understand the amount they will receive.", "why": "A merchant may see a sale recorded at one amount and a payout arrive at another. An itemized settlement lets them see whether the difference is due to applicable processing charges or something that needs checking.", "severity": 3, "rank": 8}, {"id": "final-10.08", "title": "Why do merchants face chargebacks and settlement delays?", "description": "A merchant can complete a sale but receive the money later than expected or see it reversed after a dispute.", "why": "Unclear settlement and dispute records make it difficult to reconcile sales and plan cash flow.", "severity": 4, "rank": 6}, {"id": "final-10.09", "title": "How can small shops confirm incoming UPI payments securely even when connectivity is unreliable or screenshots are fake?", "description": "A screenshot can resemble proof of payment even when no money arrived.", "why": "Weak connectivity makes it harder for a shop to verify the credit from its own account or payment provider at checkout.", "severity": 4, "rank": 2}, {"id": "final-10.10", "title": "How can street vendors maintain a consolidated daily sales ledger across several UPI apps?", "description": "A vendor accepting payments across several apps may have to check each history separately.", "why": "Without a combined record, it is harder to total sales for the day and identify missing or duplicate records.", "severity": 3, "rank": 9}, {"id": "final-10.11", "title": "How can merchants match identical-amount incoming payments to the correct customer order?", "description": "Several customers can send the same amount within minutes.", "why": "A merchant needs an order reference or other reliable identifier to avoid assigning a valid payment to the wrong sale.", "severity": 3, "rank": 9}, {"id": "final-10.12", "title": "How can merchants detect and refund two payments made for the same order?", "description": "When a customer retries a payment, both attempts can eventually succeed.", "why": "A merchant needs to link the two credits to one order before reversing the extra payment.", "severity": 3, "rank": 10}, {"id": "final-10.13", "title": "How can businesses match payment-gateway records against bank settlement batches and identify missing payouts?", "description": "A bank deposit can bundle many gateway transactions after fees or adjustments.", "why": "Businesses need to connect each sale and deduction to the settlement batch to identify a real payout gap.", "severity": 4, "rank": 6}, {"id": "final-10.14", "title": "How can recurring-payment systems support temporary mandate pauses without terminating a subscription?", "description": "People may want to pause billing for a short period while keeping their subscription.", "why": "If the payment mandate only supports cancellation, pausing can require a new authorization later.", "severity": 2, "rank": 11}]}, {"id": "Real Estate", "name": "Real Estate", "problems": [{"id": "final-11.01", "title": "How can apartment associations coordinate preventive maintenance of shared lifts, water pumps, and electrical systems?", "description": "Maintenance schedules for shared equipment can live with different technicians or committee members.", "why": "Associations need one clear record of what has been serviced, what is due, and who is responsible.", "severity": 4, "rank": 7}, {"id": "final-11.02", "title": "How can apartment residents check line-item charges on recurring society maintenance bills?", "description": "A single maintenance amount can combine repairs, operating costs, and reserves. Residents need itemized records to understand what changed and ask informed questions.", "why": "A higher bill is difficult to understand if residents cannot distinguish a one-time repair from a permanent increase. A breakdown lets them compare the charge with the approved budget and previous periods.", "severity": 3, "rank": 13}, {"id": "final-11.03", "title": "Why do builders delay possession for years?", "description": "A possession date can slip while buyers receive only broad construction updates.", "why": "Families need to understand which milestones are incomplete and how the delay affects move-in and housing costs.", "severity": 5, "rank": 1}, {"id": "final-11.04", "title": "Why must buyers keep paying EMIs on stalled projects?", "description": "Construction progress and a buyer’s financing obligations can follow separate schedules. Buyers can face ongoing payments while still paying for somewhere else to live.", "why": "A household budgeting for a move can instead end up paying for both the delayed property and current housing. Construction updates do not automatically explain how long this overlap will last.", "severity": 4, "rank": 2}, {"id": "final-11.05", "title": "Why do builders and housing boards refuse refunds even after years of delay?", "description": "A delayed project can leave a household seeking a refund from an organization that controls both funds and progress updates.", "why": "Buyers need a clear record of payment, promises, and the response to their request.", "severity": 4, "rank": 3}, {"id": "final-11.06", "title": "Why do state RERA authorities fail to enforce the law properly?", "description": "A housing complaint can receive a decision without corresponding progress on the ground. Buyers need visibility into follow-up, deadlines, and responsibility for implementing the decision.", "why": "A purchaser can receive a written outcome and still have no date for the promised action. They need a way to track implementation and see when the responsible party last provided an update.", "severity": 4, "rank": 3}, {"id": "final-11.07", "title": "Why does buyers' certainty vanish when a builder goes into insolvency?", "description": "Developer insolvency can leave buyers uncertain about construction, possession, and money already paid. Progress and case updates may arrive through several channels with different timelines.", "why": "Buyers may receive updates about the legal case without learning whether work on their building can resume. They need to distinguish confirmed decisions from proposals that still depend on funding or approval.", "severity": 5, "rank": 5}, {"id": "final-11.08", "title": "Why must buyers choose between RERA, NCLT and consumer forums, each with different costs?", "description": "Housing disputes can involve different forums depending on the issue and remedy sought.", "why": "Buyers need guidance about what information to collect and where to seek qualified help.", "severity": 4, "rank": 9}, {"id": "final-11.09", "title": "Why do stalled but viable projects stay stuck for lack of funds?", "description": "A project can have buyer demand and still lack cash to complete the next phase.", "why": "A viable restart depends on assessing remaining costs, funding, and the commitments already made.", "severity": 4, "rank": 1}, {"id": "final-11.10", "title": "How can homebuyers independently verify whether a housing project is legally registered and its approvals are valid before paying a booking amount?", "description": "A brochure can mention project registration without showing that the approval matches the building and phase on offer.", "why": "Buyers need to connect the advertised unit to official records before committing money.", "severity": 5, "rank": 1}, {"id": "final-11.11", "title": "How can property buyers assess a builder’s historical delays and current construction progress against promised completion dates?", "description": "A builder’s advertised completion date provides little context about past delivery or current progress.", "why": "Buyers need comparable milestone records and clear dates to judge whether the schedule looks credible.", "severity": 4, "rank": 12}, {"id": "final-11.12", "title": "How can property buyers calculate the full upfront and recurring cost of a home, including taxes, registration, brokerage, and maintenance fees?", "description": "The listed price omits some one-time and recurring costs.", "why": "Buyers need the timing and amounts of charges such as registration, brokerage, and maintenance to understand whether the purchase fits their budget.", "severity": 4, "rank": 2}, {"id": "final-11.13", "title": "How can property buyers verify the legal ownership history of a property without depending entirely on brokers?", "description": "A property may have passed through several owners or have competing claims.", "why": "Buyers need to trace records behind the seller’s ownership instead of relying only on a broker’s summary.", "severity": 5, "rank": 6}, {"id": "final-11.14", "title": "How can prospective tenants verify unresolved repairs and basic-utility problems before signing a lease?", "description": "A flat can look ready during a viewing while having recurring leaks, water shortages, or repairs that have been promised but not completed.", "why": "Tenants need a record of these issues before signing.", "severity": 4, "rank": 7}, {"id": "final-11.15", "title": "How can homebuyers identify discrepancies between promised apartment amenities and facilities actually delivered?", "description": "Amenities shown in sales material may be changed, delayed, or delivered with restricted access.", "why": "Buyers need to compare the commitments made for their project with what residents can actually use.", "severity": 4, "rank": 12}, {"id": "final-11.16", "title": "How can owners remotely track daily progress, material use, and budget changes in a self-managed house construction project?", "description": "An owner managing a build remotely may get photos, bills, and daily updates through separate messages.", "why": "Connecting those records helps the owner see whether materials, work completed, and spending agree.", "severity": 4, "rank": 12}, {"id": "final-11.17", "title": "How can homebuyers organize construction records, payment receipts and communications when filing complaints through RERA?", "description": "Details needed for a housing complaint can be scattered across payment receipts, construction updates, and correspondence.", "why": "A dated record makes it easier to explain what was promised and what happened.", "severity": 4, "rank": 7}, {"id": "final-11.21", "title": "Why are half of rental listings fake broker clickbait?", "description": "A listing may stay visible after a rental is gone or use photos from a different property.", "why": "Renters need to confirm actual availability and the person authorized to show it.", "severity": 3, "rank": 4}, {"id": "final-11.22", "title": "How do buyers discover dampness after moving into homes?", "description": "New paint can conceal moisture during a brief viewing.", "why": "Buyers need access to the property’s repair history and an opportunity to check areas likely to be affected.", "severity": 4, "rank": 11}, {"id": "final-11.23", "title": "How can residents diagnose concealed dampness and moisture ingress discovered after occupying a home?", "description": "Moisture can travel from a roof, wall, or pipe before becoming visible. Residents need an inspection that identifies the likely source so repairs address the cause.", "why": "Repainting a damp patch may improve how it looks without stopping the moisture from returning. The difficult part is tracing the source, particularly when the most visible mark is far from where water is getting in.", "severity": 4, "rank": 8}, {"id": "final-16.19", "title": "How can housing societies plan preventive drain clearing and waterlogging mitigation before monsoon rains?", "description": "Housing communities may discover blocked drains only when heavy rain causes flooding.", "why": "A record of recurring trouble spots, previous clearing work, and upcoming inspections helps residents coordinate preventive maintenance.", "severity": 4, "rank": 10}]}, {"id": "SaaS", "name": "SaaS", "problems": [{"id": "final-12.01", "title": "Why must startups report one breach to two regulators on two different clocks?", "description": "Teams handling a breach need to track which notifications apply and when each becomes due. Separate timelines can create duplicate work and inconsistent records.", "why": "The same incident can create several notification tasks, each with its own owner and evidence requirements. A single timeline helps the team track what has been sent and what still needs action.", "severity": 4, "rank": 14}, {"id": "final-12.02", "title": "Why do standard SaaS vendor contracts fall short of data processor requirements under the DPDP rules?", "description": "A standard vendor contract may leave responsibilities for deletion, subprocessors, or incident support unclear. Buyers need to identify those gaps before sharing customer data.", "why": "Even when a vendor’s product meets technical needs, its contract may leave unclear who must act when a customer asks for deletion or an incident occurs. The business needs those responsibilities spelled out before relying on the service.", "severity": 4, "rank": 10}, {"id": "final-12.03", "title": "Why can't many companies say where a customer's data physically lives, making erasure impossible?", "description": "Customer records can be copied into backups, exports, and vendor systems. A deletion request is difficult to complete when the team cannot trace those copies.", "why": "A person’s contact details may be removed from one tool while copies remain in a report or another service. The team needs to know where copies live so it can determine what is still outstanding.", "severity": 4, "rank": 4}, {"id": "final-12.04", "title": "Why do small startups struggle with the cost of DPDP compliance?", "description": "Small teams may have limited budget for mapping data, updating processes, and documenting their work.", "why": "The burden grows when the same information must be maintained in several tools.", "severity": 4, "rank": 7}, {"id": "final-12.05", "title": "Why can missing a security safeguard cost up to ₹250 crore?", "description": "A missed data safeguard can expose customers and create substantial consequences for a company.", "why": "Teams need to know which safeguards apply and whether they work in practice.", "severity": 4, "rank": 9}, {"id": "final-12.06", "title": "Why does consent risk becoming a click-through ritual instead of an auditable record?", "description": "A click alone may not show what notice a customer saw or which uses they agreed to.", "why": "An auditable record connects the choice to the notice and later changes.", "severity": 4, "rank": 5}, {"id": "final-12.07", "title": "Why do SaaS startups often lack testing evidence to defend themselves after a breach?", "description": "After an incident, a team may need to show what was tested, when, and whether problems were fixed.", "why": "Evidence is harder to reconstruct if earlier checks were only informal.", "severity": 4, "rank": 12}, {"id": "final-12.08", "title": "Why can't startups rely on consent managers yet?", "description": "Consent tools need to exchange records with the services that actually use customer data.", "why": "A startup must understand where integration or coverage still requires its own work.", "severity": 4, "rank": 15}, {"id": "final-12.09", "title": "How can businesses flag abnormal employee activity and unauthorized access to customer records across their software apps?", "description": "Access records can be split across several software tools.", "why": "A business needs to see unusual access in context, including whether it matches the person’s role or recent changes in responsibilities.", "severity": 5, "rank": 2}, {"id": "final-12.10", "title": "How can businesses automatically revoke access to SaaS tools when employees leave or change roles?", "description": "When an employee leaves or changes roles, accounts and shared permissions may remain active in tools the business has overlooked.", "why": "A complete inventory helps teams track which access needs to be removed.", "severity": 4, "rank": 11}, {"id": "final-12.12", "title": "How can small enterprises maintain secure backups of business-critical documents without employing full-time IT professionals?", "description": "A backup can appear configured even if some documents are missing or cannot be restored.", "why": "Small teams need visibility into what is covered and whether recovery has been checked.", "severity": 5, "rank": 2}, {"id": "final-12.13", "title": "How can companies monitor important changes to shared documents when multiple employees edit the same files?", "description": "Version histories can contain many edits that obscure consequential changes. Teams need to know which sections changed and who should review them.", "why": "A reviewer may need to see a changed deadline or approval while many small formatting edits happen around it. A useful update identifies what changed and gives the reviewer enough context to decide whether it matters.", "severity": 3, "rank": 16}, {"id": "final-12.14", "title": "How can small businesses manage customer consent and personal-data deletion requests across different software tools?", "description": "Customer information can be copied across sales, billing, and support tools.", "why": "A business handling a request needs to know where the customer’s data exists and which steps are still pending.", "severity": 4, "rank": 8}, {"id": "final-12.15", "title": "How can organizations identify suspicious files and phishing links received through business email and messaging platforms?", "description": "Suspicious files and links arrive through multiple workplace channels.", "why": "Teams need a consistent way to identify and report them so the same issue does not get handled separately by each employee.", "severity": 5, "rank": 1}, {"id": "final-12.16", "title": "How can small businesses automatically generate clear security incident reports from technical logs without specialist knowledge?", "description": "Incident evidence may be spread across logs written for different tools.", "why": "A small team needs a readable timeline of what happened, what data or systems were affected, and what remains uncertain.", "severity": 4, "rank": 13}, {"id": "final-12.17", "title": "How can organizations check whether their third-party software providers meet basic data-protection and cybersecurity requirements before sharing business information?", "description": "A vendor may advertise security features without explaining how it stores or shares customer information. Buyers need comparable evidence about the provider’s practices before granting access.", "why": "A feature list rarely answers who can see uploaded records or what happens when an account is closed. Those details help buyers judge whether the service fits the kind of data they intend to share.", "severity": 5, "rank": 2}, {"id": "final-12.20", "title": "How can data flow seamlessly between Excel, CRM, and invoicing systems?", "description": "Separate spreadsheets, customer systems, and invoices often use different identifiers. Copying data between them can create stale records and duplicate entries.", "why": "A customer name can be updated in a spreadsheet while the CRM and invoice still use the old details. Teams need to know which record to trust and how to recognize the same customer across systems.", "severity": 4, "rank": 3}, {"id": "final-12.22", "title": "How do small teams struggle with manual payroll calculations?", "description": "Payroll becomes difficult when attendance, deductions, and adjustments sit in separate records. Manual reconciliation increases the chance of delayed or incorrect pay.", "why": "A missed shift or correction to overtime may affect one employee while leaving the rest of the payroll unchanged. Finding that difference before pay is issued requires the source records to agree.", "severity": 4, "rank": 6}, {"id": "final-12.23", "title": "How can kirana stores predict restocking needs using past sales data?", "description": "Small stores must reorder before shelves empty without tying up too much cash. Past sales can help if records distinguish seasonal demand and stockouts.", "why": "A zero sales day can indicate low demand or simply mean the item was out of stock. Stores need to distinguish those cases before using past sales to decide how much to order.", "severity": 4, "rank": 4}]}, {"id": "Transportation", "name": "Transportation", "problems": [{"id": "final-13.01", "title": "How can vehicle owners verify workshop diagnoses before paying for potentially unnecessary car repairs?", "description": "A driver may receive a repair recommendation without seeing the evidence behind it.", "why": "It is hard to compare quotes if workshops describe the same symptoms and proposed work in different terms.", "severity": 4, "rank": 12}, {"id": "final-13.04", "title": "Why do factory workers lack affordable first-mile transport to factory jobs?", "description": "A shift may start before affordable transport runs between workers’ neighborhoods and factory sites.", "why": "The journey becomes harder when several operators cover different parts of the commute and do not connect reliably.", "severity": 4, "rank": 12}, {"id": "final-13.05", "title": "How can local authorities prioritize dangerous road segments for practical crash-reduction improvements?", "description": "Local authorities may have crash reports, resident complaints, and traffic counts in separate systems. Combining them can help reveal which segments need practical safety changes first.", "why": "A road with many crashes may carry far more traffic than a nearby road with fewer reports. Comparing the type of crashes, their locations, and how people use each road gives planners a clearer picture.", "severity": 5, "rank": 2}, {"id": "final-13.06", "title": "How can road-safety teams find recurring overspeeding hotspots before serious collisions happen?", "description": "Teams need speed measurements tied to place, time, and traffic conditions to find recurring risks. Isolated complaints offer less guidance on where to intervene first.", "why": "Reports of speeding are easier to act on when they show whether the issue repeats at the same time or location. Those patterns can help teams choose where to investigate before deciding on an intervention.", "severity": 4, "rank": 4}, {"id": "final-13.07", "title": "How can hit-and-run victims and responders preserve vehicle-identification evidence quickly after a crash?", "description": "Useful details can disappear after vehicles leave and witnesses disperse. Responders need a way to record observations and keep the original evidence associated with the incident.", "why": "Witnesses may recall different details, and a photo can become separated from its time or place. Keeping original observations together makes it easier for investigators to understand what can be verified.", "severity": 5, "rank": 10}, {"id": "final-13.08", "title": "How can accident responders confirm eligibility and admission procedures for cashless emergency treatment?", "description": "During a crash response, uncertainty about admission and payment procedures can delay coordination. Responders need reliable information for the receiving facility and the particular case.", "why": "The uncertainty is greatest when the injured person cannot explain their situation and the receiving facility needs details quickly. Responders need a clear source for case requirements and a way to communicate with the facility.", "severity": 5, "rank": 6}, {"id": "final-13.09", "title": "How can planners reconcile inconsistent road-accident datasets from different public agencies?", "description": "Police, hospitals, and road agencies can record the same crash differently. Planners need to match records and reconcile inconsistent definitions before drawing conclusions.", "why": "Two agencies may use different location descriptions or record an incident under different dates. Without checking which records refer to the same event, planners risk missing recurring hazards or counting them twice.", "severity": 4, "rank": 9}, {"id": "final-13.10", "title": "Why are FASTag users charged by mistake, even when their vehicle wasn't at the toll plaza?", "description": "A driver can see a toll debit without enough information to tell whether it belongs to their trip.", "why": "Details such as time, plaza, and vehicle association are needed to resolve a mistaken charge.", "severity": 3, "rank": 15}, {"id": "final-13.11", "title": "Why do cab drivers cancel rides after asking for the destination?", "description": "A cancellation after destination disclosure wastes time and leaves the passenger looking again.", "why": "Riders need a reliable indication that a driver can complete the trip before waiting.", "severity": 3, "rank": 11}, {"id": "final-13.12", "title": "Why can app-based fares rise up to two times the base fare at peak hours?", "description": "Peak pricing can change while a rider compares routes. A clear fare estimate helps passengers judge whether to wait, use another mode, or accept the price.", "why": "A rider can see a price rise between checking availability and choosing a car. Knowing the current total and whether it may change helps them weigh the trip against waiting or taking another route.", "severity": 3, "rank": 14}, {"id": "final-13.13", "title": "How can daily commuters identify safer routes that avoid dangerous intersections and frequently reported road hazards?", "description": "A route can be fast while having crossings or stretches where people repeatedly report hazards.", "why": "Commuters need recent route-level information if they want to weigh safety alongside travel time.", "severity": 5, "rank": 1}, {"id": "final-13.14", "title": "How can people living far from metro or railway stations find affordable and reliable last-mile transportation?", "description": "A reliable rail or metro trip can still be inconvenient if the connection between the station and home is costly or infrequent.", "why": "Passengers need options that fit the station’s hours and their budget.", "severity": 4, "rank": 10}, {"id": "final-13.15", "title": "How can public-bus riders see reliable live arrival estimates at stops where tracking is currently unavailable?", "description": "A printed bus timetable becomes less useful when vehicles are delayed or service changes.", "why": "Riders need a current arrival estimate at their stop to decide whether to wait or take another route.", "severity": 4, "rank": 10}, {"id": "final-13.16", "title": "How can commuters compare the actual total cost of traveling through multiple public-transport systems?", "description": "A trip across operators may require separate fares and transfers. Travelers need the combined cost and time for the complete route.", "why": "The cheapest fare for a single leg may produce a more costly trip after transfers and the trip to or from the station are included. Riders need to compare complete journeys before choosing.", "severity": 3, "rank": 13}, {"id": "final-13.17", "title": "How can bus passengers submit verifiable incident reports about reckless driving or unsafe conditions?", "description": "A safety complaint is harder to investigate without the vehicle, route, time, and a clear description.", "why": "Passengers need an easy way to connect reports to the trip.", "severity": 4, "rank": 7}, {"id": "final-13.18", "title": "How can electric-vehicle drivers identify working, compatible charging stations before reaching them?", "description": "A charger shown on a map may be occupied, broken, or incompatible with the vehicle. Drivers need current status and connector details before taking a detour.", "why": "A driver who arrives at an unusable charger may have to make another stop with less battery remaining. Knowing whether the station is working and whether it supports the car can prevent that detour.", "severity": 4, "rank": 8}, {"id": "final-13.19", "title": "How can elderly passengers and people with mobility disabilities determine which public-transport routes and stations are accessible?", "description": "An accessible station does not guarantee an accessible trip if lifts are out of service or transfers are difficult.", "why": "Riders need to check the whole path from street level to the destination.", "severity": 5, "rank": 2}, {"id": "final-13.20", "title": "How can fleet operators detect risky driving from vehicle telemetry before a collision occurs?", "description": "Vehicle data can show harsh braking or speeding, but those events need route context. Fleet teams need to distinguish repeated patterns from isolated maneuvers.", "why": "The same braking event can reflect an unsafe driving pattern or a necessary response to traffic. Reviewing events in context helps fleet teams decide where follow-up is appropriate.", "severity": 4, "rank": 3}, {"id": "final-13.21", "title": "How can daily commuters predict transport disruptions and choose alternative routes without checking multiple unrelated applications?", "description": "A disruption on one leg can affect a whole commute. Riders need updates across operators and alternatives that account for the remaining route.", "why": "Knowing that one service is delayed does not show whether the next connection is still reachable. Riders need alternatives based on the remaining journey, including transfer time and the availability of other services.", "severity": 3, "rank": 5}, {"id": "final-13.22", "title": "How can parents receive school-bus delay alerts and child pickup or drop-off confirmations?", "description": "Parents and schools need to know whether a delay is routine and whether a pickup or drop-off took place. Messages must reliably reach the right caregiver.", "why": "A delay notice tells a parent when to expect a bus but does not confirm that a child boarded. The system has to distinguish schedule updates from checks that a specific handoff happened.", "severity": 4, "rank": 7}, {"id": "final-13.24", "title": "How can women find safer late-night commute options with verified drivers and emergency support?", "description": "Finding a late-night ride involves more than checking availability. Riders need dependable information about driver identity, pickup arrangements, and ways to get assistance during the trip.", "why": "A ride shown as available can still leave someone waiting at a poorly lit pickup point. Riders need to know who is coming, where they should meet, and how they can contact support if plans change.", "severity": 5, "rank": 2}]}, {"id": "Travel", "name": "Travel", "problems": [{"id": "final-14.01", "title": "How can travelers obtain timely refunds from cancelled hotel, bus, or tour-package bookings?", "description": "A booking can be cancelled by a provider or a platform, leaving the traveler unsure who handles payment.", "why": "Tracking each handoff helps identify whether the refund has been approved, sent, or held.", "severity": 3, "rank": 10}, {"id": "final-14.02", "title": "How can flight passengers identify booking-platform cancellation charges that exceed the airline’s own fees?", "description": "A platform fee and an airline fee can appear as one deduction. Travelers need an itemized breakdown to see which terms apply to their booking.", "why": "If the booking platform presents both charges together, the passenger may assume the airline set the whole amount. A breakdown helps them see the platform fee separately and compare it with the terms they accepted.", "severity": 3, "rank": 10}, {"id": "final-14.03", "title": "How can travelers see all compulsory booking-platform fees before reaching the final payment screen?", "description": "A low headline rate can increase after platform or property fees appear at checkout. Travelers need the total mandatory cost before comparing similar bookings.", "why": "When required fees appear late, a traveler may spend time comparing offers that are more expensive than they first looked. Showing the full cost early makes comparisons meaningful.", "severity": 3, "rank": 5}, {"id": "final-14.04", "title": "How can railway passengers receive refunds when promised confirmed accommodation cannot be provided?", "description": "A passenger expecting confirmed accommodation needs to know what was actually assigned and how a shortfall affects the refund.", "why": "The booking record and trip outcome must be easy to connect.", "severity": 4, "rank": 6}, {"id": "final-14.05", "title": "How can air passengers receive early warning and rebooking support during large-scale airline disruptions?", "description": "When many flights are disrupted, updates can arrive after viable alternatives have filled.", "why": "Passengers need information about their specific trip and the options available under their booking.", "severity": 4, "rank": 4}, {"id": "final-14.06", "title": "How can passengers track and accelerate overdue refunds after airlines cancel flights?", "description": "An airline may acknowledge cancellation before a refund is processed by the seller or payment provider.", "why": "Passengers need a reference number they can keep using to track where the refund stands.", "severity": 4, "rank": 4}, {"id": "final-14.07", "title": "How can flight passengers insist on the eligible cash refund instead of unwanted travel credits?", "description": "Travel credits can have restrictions or expiry dates that make them less useful than cash. Passengers need to see what options apply before accepting a credit.", "why": "Someone who cannot travel again soon may find a credit difficult to use. The choices need to be clear before accepting an option with limits on dates, routes, or use.", "severity": 3, "rank": 11}, {"id": "final-14.08", "title": "How can flyers verify unexplained deductions from airline cancellation refunds?", "description": "A refund may be smaller than the ticket price without an explanation of taxes, fees, or fare deductions.", "why": "Flyers need a calculation they can compare with the original terms.", "severity": 3, "rank": 9}, {"id": "final-14.09", "title": "How can passengers check whether airline cancellation fees are valid for bookings cancelled soon after purchase?", "description": "A passenger cancelling soon after purchase may face different terms depending on the booking and timing.", "why": "They need access to the policy that applied when they paid.", "severity": 3, "rank": 14}, {"id": "final-14.10", "title": "How can passengers collect the evidence required to escalate unresolved airline grievances through AirSewa?", "description": "Airline complaints may depend on booking records, boarding passes, and previous replies. Passengers need to gather the information into one clear timeline before escalating a case.", "why": "A passenger may remember the disruption but have trouble finding the original notice, the amount charged, or the airline’s latest response. A dated account helps separate what happened from what remains unresolved.", "severity": 3, "rank": 16}, {"id": "final-14.11", "title": "Why are baggage problems a recurring passenger complaint?", "description": "A missing or damaged bag may pass through several airports and handlers.", "why": "Passengers need a report tied to the baggage tag and timely updates on who is handling it.", "severity": 4, "rank": 3}, {"id": "final-14.12", "title": "Why do flight delays affect lakhs of passengers every month?", "description": "Delays can leave passengers with missed connections or extra costs. Up-to-date explanations and rebooking information help travelers decide what to do next.", "why": "A revised departure time is only part of the information passengers need. They may also have to decide whether a connection is still possible or whether another booking will be needed.", "severity": 4, "rank": 1}, {"id": "final-14.13", "title": "How can tourists verify whether local guides are authorized and trustworthy before hiring them?", "description": "Guide listings may omit credentials, permitted activities, and who handles disputes. Travelers need reliable information about the guide before booking.", "why": "Price and ratings do not answer whether a guide is permitted to operate at a specific attraction or can deliver the itinerary offered. Unclear credentials make it harder to compare offers fairly.", "severity": 3, "rank": 12}, {"id": "final-14.14", "title": "How can travelers budget total destination expenses, including attraction charges, permits, and local trips?", "description": "Travel budgets can miss local fares, permits, and attraction fees that are rarely listed together. A realistic estimate needs to cover the whole planned visit.", "why": "The advertised hotel rate and main ticket rarely account for every local expense. A traveler planning a budget needs to include smaller charges that accumulate over the whole visit.", "severity": 3, "rank": 13}, {"id": "final-14.15", "title": "How can tourists find accurate information about accessibility facilities at historical monuments and tourist attractions?", "description": "Attractions may describe their sites as accessible without listing steps, slopes, facilities, or assistance. Visitors need those details to judge whether they can complete the visit.", "why": "An accessible entrance alone may say little about whether someone can reach the main rooms, use a restroom, or get back to the exit. Visitors need information about the whole route through the site.", "severity": 4, "rank": 4}, {"id": "final-14.16", "title": "How can travelers identify official ticket-booking channels for monuments and popular attractions instead of fraudulent websites?", "description": "Unofficial ticket sites can resemble an attraction’s own booking page.", "why": "Travelers need an easy way to trace where the official seller is listed and who receives their payment.", "severity": 4, "rank": 4}, {"id": "final-14.17", "title": "How can tourists verify fair taxi and auto fares for individual local trips in unfamiliar cities?", "description": "A visitor may not know the local fare range or which fees apply.", "why": "Comparing estimates for the same pickup, destination, timing, and vehicle helps reveal surprising charges.", "severity": 3, "rank": 7}, {"id": "final-14.18", "title": "How can travelers identify medical facilities and emergency assistance while visiting remote tourist destinations?", "description": "Being far from a familiar town makes it hard to judge which facility is open or reachable.", "why": "Visitors need local contact and location information before an emergency occurs.", "severity": 5, "rank": 2}, {"id": "final-14.19", "title": "How can tourists receive reliable updates about temporary closures, restricted entry and permit requirements at attractions?", "description": "An attraction may close temporarily or require a permit even if older listings show normal hours.", "why": "Travelers need updates that apply to their date and planned entrance.", "severity": 3, "rank": 15}, {"id": "final-14.20", "title": "How can travelers find safe and suitable accommodation when visiting smaller Indian towns with limited verified online information?", "description": "Smaller destinations may have few recent reviews or accurate listings. Guests need to verify availability, location, and basic facilities before arriving.", "why": "A photo or old review may not confirm whether a room still exists, is open on the planned date, or is reachable in the evening. Verifying basic details in advance matters more where alternatives are limited.", "severity": 4, "rank": 5}, {"id": "final-14.21", "title": "How can tourists obtain trustworthy local safety information in their preferred language when visiting unfamiliar regions?", "description": "Local safety updates can be difficult to find or interpret in an unfamiliar language. Visitors need timely information with a reliable source and a clear location.", "why": "A translated message is only useful if readers can tell when it was issued and which area it covers. Otherwise, tourists may confuse a local update with a restriction that applies to their own trip.", "severity": 4, "rank": 3}, {"id": "final-14.22", "title": "How can travelers plan realistic multi-destination trips that account for local transport availability, sightseeing duration and seasonal restrictions?", "description": "A route that looks short on a map may not fit opening hours, transport schedules, or seasonal restrictions. A usable itinerary accounts for delays and connections.", "why": "A plan can look reasonable until it includes a transfer after the last local service or arrives just before closing. Building in travel and waiting time helps show whether the stops fit into one day.", "severity": 3, "rank": 8}, {"id": "final-14.24", "title": "How can solo women travelers find women-focused trip-planning, lodging, and community safety resources?", "description": "General travel listings rarely describe the details solo travelers use to assess a trip, such as late arrival arrangements and host availability.", "why": "More specific information makes it easier to plan lodging and transport together.", "severity": 4, "rank": 4}]}, {"id": "Healthtech", "name": "Healthtech", "problems": [{"id": "final-15.01", "title": "How can patients audit itemized hospital bills for unsupported, duplicated, or excessive charges after treatment?", "description": "Hospital invoices can combine many charges whose names differ from the services patients remember receiving.", "why": "Itemized records help patients compare what was billed with what the hospital says was provided.", "severity": 5, "rank": 4}, {"id": "final-15.02", "title": "Why do patients get unnecessary diagnostic tests and procedures?", "description": "Patients may not know why a test was recommended or how the result would affect care.", "why": "Clear explanations and usable records help them discuss the recommendation with a qualified clinician.", "severity": 4, "rank": 3}, {"id": "final-15.03", "title": "How can patients obtain a comparable estimate of total hospital treatment costs before admission?", "description": "Two hospitals can quote different packages with different inclusions.", "why": "Patients need to see what is covered and what could be billed separately to compare likely total costs before admission.", "severity": 5, "rank": 4}, {"id": "final-15.04", "title": "Why are medicines sold above the government's ceiling prices?", "description": "Patients can struggle to compare the amount charged with the applicable price for the exact medicine and pack.", "why": "They need a trustworthy source and a record of what they paid.", "severity": 4, "rank": 9}, {"id": "final-15.05", "title": "How can patients verify health-insurance eligibility and required documents before submitting a claim?", "description": "Coverage and documentation requirements can differ across policies and procedures. Patients need to check both before submitting to avoid missing records and delays.", "why": "A patient may learn that something is missing only after sending a claim. Seeing the documents and coverage conditions for their specific policy and procedure helps them understand what the insurer will need to review it.", "severity": 4, "rank": 8}, {"id": "final-15.06", "title": "How can patients challenge cashless health claims provisionally approved at admission but denied at discharge?", "description": "An approval at admission may be provisional, while the final claim is evaluated against discharge records.", "why": "Patients need a clear explanation of any change and the documents behind it.", "severity": 5, "rank": 4}, {"id": "final-15.07", "title": "How can policyholders track delayed or partially settled health-insurance claims and escalate them?", "description": "A claim can be acknowledged without showing which items were approved, reduced, or held. Policyholders need a clear breakdown and a record of communications.", "why": "A partial payment can leave a policyholder unsure which costs are final and which are still being reviewed. Clear decisions for each item help them identify where a document or response is missing.", "severity": 4, "rank": 6}, {"id": "final-15.08", "title": "How can rural patients check availability of a specific diagnostic test at nearby centers before travel?", "description": "A center can list a test without offering it on the day a patient plans to visit.", "why": "Rural patients need current availability and appointment information before making a long trip.", "severity": 4, "rank": 11}, {"id": "final-15.09", "title": "How can patients easily obtain and organize medical records from different hospitals and diagnostic laboratories?", "description": "Different providers may release reports in different formats or portals.", "why": "Missing documents can make it hard for patients to share a complete history with a new care team.", "severity": 5, "rank": 1}, {"id": "final-15.10", "title": "How can patients and community health workers coordinate reminders and missed follow-ups for chronic tests, antenatal checkups, and vaccinations?", "description": "Follow-up schedules can be split across clinics, family members, and community workers.", "why": "When a visit is missed, the people coordinating care need to know what happened and which appointment requires follow-up.", "severity": 5, "rank": 1}, {"id": "final-15.11", "title": "How can rural patients identify the nearest currently available specialist consultation, separate from diagnostic testing?", "description": "A diagnostic center may be nearby even when the specialist the patient needs is not available.", "why": "Patients need separate information about consultation locations, schedules, and booking requirements.", "severity": 5, "rank": 4}, {"id": "final-15.12", "title": "How can hospitals automatically identify missing patient information before scheduled medical consultations?", "description": "Missing referrals, prior results, or medication records can delay a consultation. Clinics need to identify gaps before the appointment and tell patients what is needed.", "why": "A patient can arrive on time and still be unable to complete an appointment if the clinician needs a record from elsewhere. Early notice gives the patient time to retrieve it before making the trip.", "severity": 4, "rank": 8}, {"id": "final-15.13", "title": "How can patients verify whether medicines purchased from pharmacies belong to batches identified in official drug-quality alerts?", "description": "Drug-quality alerts can apply to a particular batch.", "why": "Patients need to match the identifier on their packaging to an official alert without confusing products with similar names.", "severity": 5, "rank": 10}, {"id": "final-15.14", "title": "How can small clinics monitor the availability of essential medicines and medical supplies before stocks run out?", "description": "A clinic may discover that an essential item is unavailable only when it is needed.", "why": "Stock counts, usage patterns, and restocking lead times need to be visible together.", "severity": 4, "rank": 5}, {"id": "final-15.15", "title": "How can discharged patients receive clear, language-appropriate instructions about medicines, recovery and when to seek urgent medical attention?", "description": "Discharge instructions can use unfamiliar terms or a language the patient does not read comfortably.", "why": "Patients and caregivers need to understand the care instructions and how to contact the care team with concerns.", "severity": 5, "rank": 1}, {"id": "final-15.16", "title": "Why do medicine prices vary wildly across pharmacy chains?", "description": "Prices can differ for the same product and pack across stores. Buyers need to compare like-for-like listings and confirm that the product is actually in stock.", "why": "A low price may be for a different pack size or an item that is unavailable at that branch. Useful comparisons tie the price to the exact product, quantity, and current location.", "severity": 4, "rank": 9}, {"id": "final-15.17", "title": "Why do patients lack tools to compare conflicting diagnoses confidently?", "description": "Patients may receive different assessments without knowing whether the clinicians reviewed the same information. A complete record helps a qualified clinician explain where the opinions differ.", "why": "Two assessments can appear to contradict each other when each clinician has seen a different set of results. Patients need to understand what information was considered and which questions remain open.", "severity": 4, "rank": 7}, {"id": "final-15.18", "title": "Why do emergency rooms lack systems to prioritize critical patients instantly?", "description": "Emergency departments need to assess people with different levels of urgency as they arrive.", "why": "When information is incomplete or the department is crowded, care teams need a way to share changes in patient status promptly.", "severity": 5, "rank": 2}, {"id": "final-15.19", "title": "Why are diagnostic services not designed for women's privacy and mobility needs?", "description": "Some appointments require facilities or scheduling that protect privacy and accommodate mobility needs. Patients need to know what is available before making a trip.", "why": "A center may list the right test without explaining how patients enter the building, change privately, or arrange help. Knowing those details in advance can determine whether someone can attend the appointment.", "severity": 4, "rank": 4}, {"id": "final-15.20", "title": "Why do branded drugs dominate prescriptions despite equivalent, cheaper generic alternatives?", "description": "Patients may hear several names for medicines with similar ingredients and be unsure how they differ.", "why": "Clear product information helps them discuss cost and suitability with a clinician or pharmacist.", "severity": 4, "rank": 5}]}, {"id": "Common Problems", "name": "Common Problems", "problems": [{"id": "final-16.01", "title": "How can residents find verified animal-rescue responders during urgent incidents involving stray or injured animals?", "description": "Residents who find an injured animal may know several numbers without knowing which responder has coverage in their area.", "why": "Verifying availability and the exact location can reduce time lost during handoffs.", "severity": 4, "rank": 13}, {"id": "final-16.03", "title": "How can citizens route a government-service grievance to the correct authority with complete evidence at first submission?", "description": "The office that receives a complaint may lack authority to act on it.", "why": "Citizens need to know where to submit the issue and what evidence will help the responsible office investigate it.", "severity": 3, "rank": 7}, {"id": "final-16.04", "title": "How can citizens monitor overdue state-government grievances and escalate cases with no resolution update?", "description": "After a complaint is filed, a case number may be the only update a resident receives.", "why": "A clear timeline helps them distinguish a case still within its response window from one that needs follow-up.", "severity": 3, "rank": 13}, {"id": "final-16.05", "title": "How can phone users block repeat unsolicited marketing calls and texts without missing legitimate service alerts?", "description": "Unwanted messages can come from changing numbers or sender IDs.", "why": "Aggressive filtering can also hide genuine alerts, so users need more reliable signs of what to block.", "severity": 4, "rank": 2}, {"id": "final-16.06", "title": "How can regulators identify unregistered telemarketers and connect repeat spam reports to their operators?", "description": "Repeat complaints may refer to changing numbers that are hard to connect. Regulators need reliable records that link reports to the responsible operator.", "why": "Reports can include similar messages sent from different numbers or incomplete information about the sender. Linking those reports to a responsible operator requires evidence that connects the messages rather than relying on a single number.", "severity": 3, "rank": 5}, {"id": "final-16.07", "title": "How can consumers report spam calls with minimal manual entry from their call logs?", "description": "A spam complaint often asks for details already visible in a call log. Reducing duplicate entry can make reporting practical while the information is fresh.", "why": "Typing numbers, timestamps, and message details by hand makes reporting harder after a brief interruption. Letting someone review information already on their device can make the report easier to complete accurately.", "severity": 2, "rank": 12}, {"id": "final-16.08", "title": "How can rural households independently check whether their drinking-water source meets safety standards?", "description": "People may rely on a shared water source without recent information about its quality.", "why": "A clear test record needs to identify the source, date, and what was actually checked.", "severity": 5, "rank": 1}, {"id": "final-16.09", "title": "How can village residents know when waste-collection vehicles will actually reach their neighborhoods?", "description": "A collection route can vary from day to day.", "why": "Residents need reliable arrival updates to place waste out in time without leaving it outside for long periods.", "severity": 3, "rank": 9}, {"id": "final-16.10", "title": "How can communities file geotagged reports of overflowing drains and track repair completion?", "description": "Flooded or overflowing drains can be reported by many residents under different location descriptions.", "why": "A precise location and repair status can help authorities consolidate reports and communicate progress.", "severity": 4, "rank": 8}, {"id": "final-16.11", "title": "How can households locate authorized disposal points for e-waste, batteries, household hazards, construction debris, and bulky waste?", "description": "Different kinds of household waste may require different facilities. People need to know which authorized sites accept the item and when they can drop it off.", "why": "A resident may take batteries or old electronics to a collection point only to discover it accepts a different kind of waste. Accepted materials, hours, and quantity limits matter before making the trip.", "severity": 3, "rank": 13}, {"id": "final-16.12", "title": "How can small villages coordinate the collection of recyclable materials when they generate insufficient quantities for regular commercial pickups?", "description": "Small villages may produce too little recyclable material for a regular individual pickup. Coordinating collection times and storage can make a shared route practical.", "why": "A collector serving one small village may travel a long distance for a light load. Combining pickups can help, but communities still need somewhere to store material and an agreed schedule.", "severity": 3, "rank": 10}, {"id": "final-16.13", "title": "How can residents identify and report broken streetlights with accurate location information?", "description": "A broken streetlight can be difficult to identify from a street name alone. Precise location and a visible repair status help keep the same report from being sent twice or to the wrong team.", "why": "Several lamps can be on the same road and only one may be broken. A nearby landmark or pole identifier can help the crew find the correct light on its first visit.", "severity": 4, "rank": 10}, {"id": "final-16.14", "title": "How can local communities track recurring water-supply interruptions and document how long each interruption lasts?", "description": "Individual outages may look isolated until residents document their times and locations.", "why": "A shared record can show how often the water supply stops and which areas are affected.", "severity": 4, "rank": 3}, {"id": "final-16.15", "title": "How can village councils monitor whether community waste-processing and water-treatment facilities are functioning consistently?", "description": "A community facility may be listed as operating without a current record of outages or inspections. Councils need to identify recurring faults and assign follow-up.", "why": "A council may know a pump was installed without knowing how often it stops working. A dated record of interruptions and repairs helps show where maintenance or follow-up is needed.", "severity": 4, "rank": 4}, {"id": "final-16.16", "title": "Why can't citizens verify whether segregated waste is actually recycled?", "description": "Sorting waste at home does not show what happened after collection. Communities need records connecting collection, processing, and final disposal.", "why": "Even if waste leaves homes in separate containers, residents may never learn whether it was later mixed, rejected, or sent to a recycling facility. The gap is in tracking the material after pickup.", "severity": 4, "rank": 6}, {"id": "final-16.17", "title": "Why don't smart water systems detect underground leaks automatically?", "description": "A leak can go unnoticed below ground while water continues to leave the system.", "why": "Monitoring needs to distinguish normal demand changes from unusual losses and help narrow down where to inspect.", "severity": 4, "rank": 8}, {"id": "final-16.18", "title": "How can residents report hazardous trees on public land and request urgent inspection or removal?", "description": "A resident may notice a damaged tree without knowing who manages the land.", "why": "Clear routing and location information can get an inspection request to the proper team.", "severity": 4, "rank": 11}]}, {"id": "Jobs & Employment", "name": "Jobs & Employment", "problems": [{"id": "final-16.02", "title": "How can qualified job applicants diagnose and improve résumé compatibility with applicant-tracking systems?", "description": "An application can be screened before a recruiter reads the résumé.", "why": "Candidates need to know whether relevant qualifications were read correctly and whether document formatting hid important information.", "severity": 4, "rank": 1}]}]</script>
<script>
const get=id=>document.getElementById(id);
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
const shuffle=items=>items.map(item=>[Math.random(),item]).sort((a,b)=>a[0]-b[0]).map(pair=>pair[1]);
const random=(a,b)=>a+Math.random()*(b-a);
const W=210,H=297,PW=62,PH=78;
async function loadCategories(){return JSON.parse(get('catalog').textContent);}
function pickProblems(categories){
 const queues=shuffle(categories).map(category=>{
  const valid=category.problems.filter(problem=>problem.title?.trim());
  const ranked=valid.some(problem=>Number.isFinite(problem.rank));
  return {category,queue:(ranked?shuffle(valid).sort((a,b)=>(a.rank??Infinity)-(b.rank??Infinity)):valid)};
 }).filter(entry=>entry.queue.length);
 const chosen=[];
 while(chosen.length<12&&queues.some(entry=>entry.queue.length)){
  for(const entry of queues){
   if(chosen.length===12)break;
   if(entry.queue.length)chosen.push({category:entry.category,problem:entry.queue.shift()});
  }
 }
 if(chosen.length!==12)throw Error('There are fewer than twelve available problems.');
 return chosen;
}
function contains(p,x,y){
 const dx=x-p.x,dy=y-p.y;
 return Math.abs(dx*p.cos+dy*p.sin)<PW/2&&Math.abs(dy*p.cos-dx*p.sin)<PH/2;
}
function sample(p,n){
 const points=[];
 for(let row=0;row<n;row++)for(let column=0;column<n;column++){
  const x=(column+.5)/n*PW-PW/2,y=(row+.5)/n*PH-PH/2;
  points.push([p.x+x*p.cos-y*p.sin,p.y+x*p.sin+y*p.cos,Math.floor(3*row/n)]);
 }
 return points;
}
function generateLayout(){
 for(let attempt=0;attempt<140;attempt++){
  const cards=[];
  for(let i=0;i<12;i++){
   const band=Math.floor(i/4),target=random(.15,.45);
   let best,bestCost=Infinity;
   for(let k=0;k<64;k++){
    const rotation=random(-34,34),angle=rotation*Math.PI/180,cos=Math.cos(angle),sin=Math.sin(angle);
    const ex=(PW*cos+PH*Math.abs(sin))/2,ey=(PH*cos+PW*Math.abs(sin))/2;
    const p={rotation,cos,sin,x:random(ex+1,W-ex-1),y:random(Math.max(ey+1,band*99),Math.min(H-ey-1,(band+1)*99))};
    const points=sample(p,5);
    const overlap=Math.max(0,...cards.map(c=>points.filter(([x,y])=>contains(c,x,y)).length/points.length));
    const distance=cards.reduce((min,c)=>Math.min(min,Math.hypot(c.x-p.x,c.y-p.y)),Infinity);
    const cost=Math.abs(overlap-target)+Math.max(0,28-distance)/22+random(0,.12);
    if(cost<bestCost){best=p;bestCost=cost;}
   }
   cards.push(best);
  }
  const faces=cards.map(p=>sample(p,17));
  const masks=faces.map(points=>points.map(([x,y])=>cards.reduce((mask,p,j)=>contains(p,x,y)?mask|(1<<j):mask,0)));
  let winner=null,score=.32;
  for(let attemptOrder=0;attemptOrder<100;attemptOrder++){
   const order=shuffle(cards.map((_,i)=>i));
   let above=0,min=1;
   for(let z=11;z>=0;z--){
    const i=order[z];
    min=Math.min(min,masks[i].filter(mask=>!(mask&above)).length/faces[i].length);
    above|=1<<i;
    if(min<=score)break;
   }
   if(min>score){score=min;winner=order;}
  }
  if(winner){
   let above=0;
   for(let z=11;z>=0;z--){
    const i=winner[z],visible=[random(0,7),random(0,7),random(0,7)];
    masks[i].forEach((mask,j)=>{if(!(mask&above))visible[faces[i][j][2]]++;});
    cards[i].zIndex=z+1;cards[i].anchor=['start','center','end'][visible.indexOf(Math.max(...visible))];
    above|=1<<i;
   }
   return cards;
  }
 }
 throw Error('The papers got too crowded. Try another toss.');
}
const tints=['var(--paper)','var(--amber)','var(--rose)','var(--sky)','var(--mint)','var(--lilac)'];
function PaperCard(paper,pick){
 const button=document.createElement('button');
 button.className='sheet'+(Math.random()<.4?' crease':'');
 button.type='button';
 Object.entries({left:paper.x/W*100+'%',top:paper.y/H*100+'%','--angle':paper.rotation+'deg','--layer':paper.zIndex,'--anchor':paper.anchor,'--sheet':paper.paperColor}).forEach(([key,v])=>button.style.setProperty(key,v));
 const stamp=document.createElement('span');stamp.className='stamp';stamp.textContent=pick.category.name;
 const title=document.createElement('strong');title.textContent=paper.problemTitle;
 button.append(stamp,title);button.addEventListener('click',()=>ExpandedPaper(button,paper,pick));
 return button;
}
function PaperCanvas(picks,layout){
 const desk=get('desk');
 const entries=picks.map((pick,i)=>{
  const tint=tints[i%6];
  const paper={...layout[i],id:'paper-'+i,categoryId:pick.category.id,problemId:pick.problem.id,problemTitle:pick.problem.title,paperColor:'color-mix(in srgb,color-mix(in srgb,var(--paper),'+tint+' var(--mix)),var(--ink) '+random(0,1.4).toFixed(2)+'%)'};
  return {paper,card:PaperCard(paper,pick)};
 }).sort((a,b)=>a.paper.y-b.paper.y||a.paper.x-b.paper.x);
 desk.replaceChildren(...entries.map(entry=>entry.card));
 function fit(){
  for(const {card} of entries){
   let size=Math.max(10,desk.clientWidth*.038);
   card.style.setProperty('--title-size',size+'px');
   const title=card.lastElementChild,stamp=card.firstElementChild;
   const css=getComputedStyle(card),room=card.clientHeight-parseFloat(css.paddingTop)-parseFloat(css.paddingBottom)-stamp.offsetHeight-2;
   while(title.offsetHeight>room&&size>9){size-=.25;card.style.setProperty('--title-size',size+'px');}
  }
 }
 new ResizeObserver(fit).observe(desk);fit();
 if(!reduced.matches)entries.forEach(({paper,card},i)=>card.animate([
 {transform:'translate(-50%,-50%) translate('+random(-35,35)+'px,-90px) rotate('+ (paper.rotation+random(-35,35))+'deg)',opacity:0},
 {transform:'translate(-50%,-50%) rotate('+paper.rotation+'deg)',opacity:1}
 ],{duration:560,delay:i*25,easing:'cubic-bezier(.18,.78,.25,1)',fill:'backwards'}));
}
const dialog=get('dialog'),read=dialog.querySelector('.read-sheet'),flap=dialog.querySelector('.flap'),content=get('content');
let current=null,busy=false;
async function motion(el,frames,duration,options={}){
 const animation=el.animate(frames,{duration:reduced.matches?100:duration,easing:'cubic-bezier(.19,.81,.26,1)',...options});
 await animation.finished;
}
function showFull(full){
 get('summary').hidden=full;get('full').hidden=!full;
 (full?get('back'):get('details')).focus({preventScroll:true});
}
function flight(from,to,rotation,reverse){
 const blank=document.createElement('div');blank.className='flight read-sheet';blank.style.cssText+=';--sheet:'+current.color+';padding:0;max-height:none;left:'+to.left+'px;top:'+to.top+'px;width:'+to.width+'px;height:'+to.height+'px;transform-origin:center';
 dialog.append(blank);
 const dx=from.left+from.width/2-to.left-to.width/2,dy=from.top+from.height/2-to.top-to.height/2;
 const transform='translate('+dx+'px,'+dy+'px) rotate('+rotation+'deg) scale('+from.width/to.width+','+from.height/to.height+')';
 const frames=[{transform,opacity:1},{transform:'none',opacity:1}];
 return motion(blank,reverse?frames.reverse():frames,500,{fill:'forwards'}).then(()=>blank);
}
async function ExpandedPaper(card,paper,{category,problem}){
 if(busy||dialog.open)return;
 busy=true;
 const color=getComputedStyle(card).backgroundColor;
 current={card,paper,color};
 card.classList.add('lifted');
 if(!reduced.matches)await motion(card,[{opacity:.96},{opacity:1}],220);
 get('stamp').textContent=category.name;
 get('paper-title').textContent=problem.title;
 get('rank').textContent=problem.rank===1?'Top-ranked problem in '+category.name:problem.rank?'Rank '+problem.rank+' in '+category.name:'From '+category.name;
 get('description').textContent=problem.description;
 get('why').textContent=problem.why||'The reasons behind this problem still need checking.';
 get('affects').textContent=problem.affects||'Who is most affected still needs checking.';
 get('metadata').textContent=[problem.affects&&'Affects: '+problem.affects,problem.severity&&'Severity: '+'●'.repeat(problem.severity)+'○'.repeat(5-problem.severity)+' ('+problem.severity+'/5)',problem.effort&&'Effort: '+problem.effort,problem.rank&&'Rank: '+problem.rank].filter(Boolean).join(' · ');
 get('metadata').hidden=!get('metadata').textContent;
 get('ranked').replaceChildren(...category.problems.slice().sort((a,b)=>(a.rank??Infinity)-(b.rank??Infinity)).map(p=>{const li=document.createElement('li');li.textContent=(p.rank?'#'+p.rank+' · ':'')+p.title;return li;}));
 get('summary').hidden=false;get('full').hidden=true;
 read.style.setProperty('--sheet',color);read.style.opacity='0';dialog.showModal();
 get('paper-title').focus({preventScroll:true});
 const rect=card.getBoundingClientRect(),cx=rect.left+rect.width/2,cy=rect.top+rect.height/2;
 const origin={left:cx-card.offsetWidth/2,top:cy-card.offsetHeight/2,width:card.offsetWidth,height:card.offsetHeight};
 if(!reduced.matches){
  const blank=await flight(origin,read.getBoundingClientRect(),paper.rotation+2,false);
  content.style.opacity='0';read.style.opacity='1';blank.remove();flap.hidden=false;
  await motion(flap,[{transform:'perspective(650px) rotateX(0deg)',opacity:1},{transform:'perspective(650px) rotateX(-120deg)',opacity:0}],560);
  flap.hidden=true;
  await motion(content,[{opacity:0},{opacity:1}],260);
  content.style.opacity='1';
 }else{
  await motion(read,[{opacity:0},{opacity:1}],100);
  read.style.opacity='1';
 }
 busy=false;
}
async function closePaper(){
 if(busy||!current)return;
 busy=true;
 const {card,paper}=current;
 if(!reduced.matches){
  flap.hidden=false;
  await motion(flap,[{transform:'perspective(650px) rotateX(-110deg)',opacity:0},{transform:'perspective(650px) rotateX(0deg)',opacity:1}],320);
  content.style.opacity='0';
  await motion(flap,[{opacity:1},{opacity:0}],100);flap.hidden=true;
  const rect=card.getBoundingClientRect(),cx=rect.left+rect.width/2,cy=rect.top+rect.height/2;
  const to=read.getBoundingClientRect();read.style.opacity='0';
  const blank=await flight({left:cx-card.offsetWidth/2,top:cy-card.offsetHeight/2,width:card.offsetWidth,height:card.offsetHeight},to,paper.rotation+2,true);
  await motion(blank,[{opacity:1},{opacity:0}],170);blank.remove();
 }else await motion(read,[{opacity:1},{opacity:0}],100);
 dialog.close();content.style.opacity='1';card.classList.remove('lifted');card.focus({preventScroll:true});current=null;busy=false;
}
get('close').onclick=get('return').onclick=closePaper;
get('details').onclick=()=>showFull(true);get('back').onclick=()=>showFull(false);
dialog.addEventListener('cancel',event=>{event.preventDefault();closePaper();});
dialog.addEventListener('click',event=>{if(event.target===dialog)closePaper();});
for(const name of ['wheel','touchmove']){
 document.addEventListener(name,event=>{if(dialog.open&&!read.contains(event.target))event.preventDefault();},{passive:false});
}
get('theme').onchange=event=>document.documentElement.dataset.theme=event.target.value;
async function start(){
 get('retry').hidden=true;get('status').hidden=false;get('status').textContent='Loading problems…';
 try{const picks=pickProblems(await loadCategories());PaperCanvas(picks,generateLayout());get('status').hidden=true;}
 catch(error){get('status').textContent=error.message||'The problems could not load.';get('retry').hidden=false;}
}
get('retry').onclick=start;start();
</script>
